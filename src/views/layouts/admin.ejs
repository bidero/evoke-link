<!DOCTYPE html>
<html lang="pl" class="<%= typeof adminBodyClass !== 'undefined' ? adminBodyClass : '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>try{if(localStorage.getItem('evoke-theme')==='dark')document.documentElement.classList.add('dark')}catch(e){}try{if(localStorage.getItem('evoke-admin-rail')==='0')document.documentElement.classList.add('rail-collapsed')}catch(e){}window.toggleTheme=function(){var d=document.documentElement.classList.toggle('dark');try{localStorage.setItem('evoke-theme',d?'dark':'light')}catch(e){}};window.toggleRail=function(){var c=document.documentElement.classList.toggle('rail-collapsed');try{localStorage.setItem('evoke-admin-rail',c?'0':'1')}catch(e){}};</script>
  <% const appName = (typeof settings !== 'undefined' && settings) ? settings.appName : 'Evoke LINK'; %>
  <title><%= typeof title !== 'undefined' ? title + ' — ' + appName : appName %></title>
  <link rel="stylesheet" href="/css/app.css?v=<%= assetVer %>" />
  <% if (typeof settings !== 'undefined' && settings && settings.faviconPath) { %><link rel="icon" href="<%= settings.faviconPath %>" /><% } %>
  <%- typeof pwaHead !== 'undefined' ? pwaHead : '' %>
  <%- typeof adminStyleTag !== 'undefined' ? adminStyleTag : '' %>
  <%- typeof darkStyleTag !== 'undefined' ? darkStyleTag : '' %>
  <%- typeof customStyleTag !== 'undefined' ? customStyleTag : '' %>
  <script src="/js/chunked-upload.js"></script>
  <script src="/js/passkey.js"></script>
  <%# Rysownik wykresów (pulpit + Puls) — na stronach bez [data-chart-mount] nic nie robi. %>
  <script defer src="/js/chart.js"></script>
  <script defer src="/js/alpine.min.js"></script>
</head>
<body class="bg-[var(--admin-bg)] antialiased" style="color: var(--admin-text)" x-data="{ nav: false }">
<%- typeof pwaSplash !== 'undefined' ? pwaSplash : '' %>
  <%# Desktop = „app shell" przez STICKY (NIE overflow): strona przewija się normalnie (body), a
      sidebar i nagłówek są `md:sticky` → zostają widoczne. Świadomie NIE robimy `overflow-y-auto`
      na kolumnie treści — kontener przewijania/klipujący wokół elementów z `backdrop-filter`
      (podglądy szkła w Ustawieniach → Wygląd) dawał glitch renderowania: „szary ekran i część
      znika". Mobile bez zmian (sidebar offcanvas, normalny scroll). %>
  <div class="min-h-screen flex">
    <!-- Przyciemnienie tła pod offcanvas (mobile) -->
    <div x-show="nav" x-cloak @click="nav = false" class="fixed inset-0 bg-black/40 z-30 md:hidden"></div>

    <!-- Pasek boczny (offcanvas na mobile, statyczny od md) -->
    <aside data-admin-sidebar class="fixed inset-y-0 left-0 z-40 w-60 shrink-0 bg-[var(--admin-sidebar)] border-r border-slate-200/60 flex flex-col overflow-hidden -translate-x-full md:translate-x-0 md:sticky md:top-0 md:h-screen md:self-start"
           :class="nav && '!translate-x-0'" style="color: var(--admin-sidebar-text)">
      <div data-rail-head class="h-16 flex items-center gap-2 px-6 border-b border-black/5">
        <% if (typeof settings !== 'undefined' && settings && hasLogo(settings, 'admin')) { %>
          <%- logoTag(settings, { appName, surface: 'admin', imgClass: 'h-8 max-w-[140px] object-contain' }) %>
        <% } else { %>
          <div class="w-8 h-8 shrink-0 rounded-lg bg-brand-600 flex items-center justify-center text-white font-bold">E</div>
          <span data-rail-label class="font-semibold tracking-tight"><%= appName %></span>
        <% } %>
      </div>
      <nav class="flex-1 min-h-0 overflow-y-auto px-3 py-4 space-y-1 text-sm">
        <%
          // Menu z konfiguracji (Settings.panel.menu) — scala middleware w admin.routes (res.locals.panelMenu).
          // „Ustawienia"/„Konto" przeniesione do menu profilu (prawy górny róg) — pomijamy w pasku.
          const items = ((typeof panelMenu !== 'undefined' && panelMenu) || []).filter(function(it){ return !it.hidden && it.key !== 'settings' && it.key !== 'account'; });
        %>
        <% const unread = (typeof unreadCount !== 'undefined') ? unreadCount : 0; %>
        <% const unreadM = (typeof unreadMessages !== 'undefined') ? unreadMessages : 0; %>
        <% const calDue = (typeof calendarDue !== 'undefined') ? calendarDue : 0; %>
        <% items.forEach(function(it){ %>
          <% const badge = it.key === 'notifications' ? unread : (it.key === 'messages' ? unreadM : (it.key === 'calendar' ? calDue : 0)); %>
          <a href="<%= it.href %>" data-rail-item title="<%= it.label %>"
             class="relative flex items-center justify-between px-3 py-2 rounded-lg transition <%= (typeof active !== 'undefined' && active === it.key) ? 'bg-brand-50 text-brand-700 font-medium' : 'opacity-70 hover:opacity-100 hover:bg-black/5' %>">
            <span class="inline-flex items-center gap-2.5"><span class="shrink-0 inline-flex"><%- icon(it.icon, { size: 16, cls: (typeof active !== 'undefined' && active === it.key) ? 'text-brand-600' : 'opacity-60' }) %></span><span data-rail-label><%= it.label %></span></span>
            <% if (badge > 0) { %>
              <span data-rail-badge class="ml-2 inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full bg-brand-600 text-white text-xs font-semibold"><%= badge %></span>
            <% } %>
          </a>
        <% }); %>
      </nav>
    </aside>

    <!-- Główna kolumna -->
    <div class="flex-1 flex flex-col min-w-0">
      <header class="h-16 shrink-0 md:sticky md:top-0 md:z-20 bg-[var(--admin-header)] border-b border-black/5 flex items-center justify-between px-4 sm:px-6 lg:px-8" style="color: var(--admin-header-text)">
        <div class="flex items-center gap-3 min-w-0">
          <button type="button" class="opacity-70 hover:opacity-100" @click="window.innerWidth < 768 ? (nav = true) : window.toggleRail()" aria-label="Menu / zwiń panel"><%- icon('menu', { size: 22, cls: '' }) %></button>
          <h1 class="text-lg font-semibold truncate"><%= typeof title !== 'undefined' ? title : '' %></h1>
          <% if (typeof active !== 'undefined' && active === 'dashboard') { %>
            <!-- Dostosuj pulpit — mała ikonka przy tytule; widok pulpitu łapie zdarzenie (dash-edit) -->
            <button type="button" onclick="window.dispatchEvent(new CustomEvent('dash-edit'))" title="Dostosuj pulpit" aria-label="Dostosuj pulpit"
                    class="shrink-0 opacity-40 hover:opacity-100 transition"><%- icon('pencil', { size: 15, cls: '' }) %></button>
          <% } %>
        </div>
        <%# Pole ZOSTAJE formularzem GET (bez JS działa jak dotąd: /admin/search).
            Z JS klik/fokus otwiera paletę Cmd/Ctrl+K — chip „⌘K" jako wskazówka. %>
        <form method="GET" action="/admin/search" class="hidden sm:block flex-1 max-w-xs mx-4">
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"><%- icon('search', { size: 15, cls: '' }) %></span>
            <input name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Szukaj…" aria-label="Szukaj"
                   onmousedown="event.preventDefault(); this.blur(); window.dispatchEvent(new CustomEvent('open-search'))"
                   onfocus="window.dispatchEvent(new CustomEvent('open-search'))"
                   class="w-full rounded-lg border border-slate-300 bg-white/80 pl-9 pr-12 py-1.5 text-sm text-slate-700 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none cursor-pointer" />
            <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[11px] font-medium text-slate-400 border border-slate-200 rounded px-1 py-0.5 pointer-events-none">⌘K</span>
          </div>
        </form>
        <div class="flex items-center gap-4">
          <button type="button" onclick="window.toggleTheme&&window.toggleTheme()" class="opacity-70 hover:opacity-100" title="Tryb jasny/ciemny" aria-label="Przełącz tryb">
            <span class="dark:hidden"><%- icon('moon', { size: 19, cls: '' }) %></span>
            <span class="hidden dark:inline"><%- icon('sun', { size: 19, cls: '' }) %></span>
          </button>
          <a href="/admin/notifications" class="relative opacity-70 hover:opacity-100" title="Powiadomienia">
            <%- icon('bell', { size: 20, cls: '' }) %>
            <% const unreadH = (typeof unreadCount !== 'undefined') ? unreadCount : 0; %>
            <% if (unreadH > 0) { %>
              <span class="absolute -top-1 -right-1 inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[10px] font-bold"><%= unreadH %></span>
            <% } %>
          </a>
          <% const _prof = (typeof settings !== 'undefined' && settings) ? settings.profile : null; %>
          <% const _email = (typeof currentUser !== 'undefined' && currentUser) ? currentUser.email : ''; %>
          <% const _pnm = (_prof && _prof.name) ? _prof.name : _email; %>
          <%# Menu profilu (prawy górny róg): Mój profil / Ustawienia / Wyloguj. %>
          <div class="relative shrink-0" x-data="{ menu: false }" @click.outside="menu = false" @keydown.escape.window="menu = false">
            <button type="button" @click="menu = !menu" class="flex items-center gap-2 group" title="Menu konta">
              <% if (_prof && _prof.avatarPath) { %>
                <img src="<%= _prof.avatarPath %>" alt="" class="w-8 h-8 rounded-full object-cover border border-black/10" />
              <% } else { %>
                <span class="w-8 h-8 rounded-full bg-brand-50 text-brand-700 inline-flex items-center justify-center text-sm font-semibold"><%= (_pnm || '?').trim().charAt(0).toUpperCase() %></span>
              <% } %>
              <span class="hidden sm:inline text-sm opacity-70 group-hover:opacity-100 max-w-[160px] truncate"><%= _pnm %></span>
              <span class="hidden sm:inline opacity-50 transition-transform" :class="menu && 'rotate-180'"><%- icon('chevronDown', { size: 15, cls: '' }) %></span>
            </button>
            <div x-show="menu" x-cloak x-transition.opacity.duration.100ms class="absolute right-0 mt-2 w-56 rounded-xl border border-slate-200 bg-white shadow-lg py-1.5 z-50" style="color: var(--admin-text)">
              <div class="px-3 py-2 border-b border-slate-100">
                <div class="text-sm font-medium text-slate-800 truncate"><%= _pnm || 'Administrator' %></div>
                <% if (_prof && _prof.name && _email) { %><div class="text-xs text-slate-400 truncate"><%= _email %></div><% } %>
              </div>
              <a href="/admin/account" class="flex items-center gap-2.5 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition"><%- icon('userCheck', { size: 16, cls: 'opacity-70' }) %> Mój profil</a>
              <% if (typeof isAdmin === 'undefined' || isAdmin) { %>
                <a href="/admin/users" class="flex items-center gap-2.5 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition"><%- icon('users', { size: 16, cls: 'opacity-70' }) %> Konta</a>
                <a href="/admin/settings" class="flex items-center gap-2.5 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition"><%- icon('cog', { size: 16, cls: 'opacity-70' }) %> Ustawienia</a>
              <% } %>
              <div class="border-t border-slate-100 my-1"></div>
              <form method="POST" action="/admin/logout">
                <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 text-left transition"><%- icon('arrowRight', { size: 16, cls: 'opacity-70' }) %> Wyloguj</button>
              </form>
            </div>
          </div>
        </div>
      </header>
      <main class="flex-1 p-4 sm:p-6 lg:p-8">
        <%- body %>
      </main>
    </div>
  </div>
  <%# Paleta Cmd/Ctrl+K — poza app-shellem (własna nakładka fixed). Wstawiana jako gotowy
      HTML (utils/searchPalette), NIE przez include: layout musi działać także dla widoków
      z localem `client` (patrz GOTCHA w utils/searchPalette.js). %>
  <%- typeof searchPalette !== 'undefined' ? searchPalette : '' %>
</body>
</html>
