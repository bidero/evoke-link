<%# GOTCHA EJS: local NIE MOŻE nazywać się `client` — ejs.renderFile kopiuje z locals opcje
    kompilatora (m.in. `client`), a truthy `client` przełącza szablon w tryb client-side i `include()`
    przestaje istnieć („include is not a function"). Ten widok includuje `_bubble`, więc klient
    rozmowy jedzie jako `convClient` (wzorzec: portalClient w /c, onbClient w onboardingu). %>
<%
  // Dwupanel: lista klientów (lewa) ↔ jeden strumień rozmowy (prawa). Dane z message.controller.
  var selNone = selected === 'none';
  var hasSel = !!selected && (!!convClient || selNone);
  // Selektor kontekstu wysyłki: Ogólne + projekty klienta + transfery OBECNE w tej rozmowie.
  var threadTransfers = {};
  (messages || []).forEach(function (m) { if (m.transfer) threadTransfers[m.transfer.id] = m.transfer.title || ('Transfer #' + m.transfer.id); });
  var lastMsg = (messages || [])[(messages || []).length - 1];
  var tabs = (typeof threads !== 'undefined' && threads) ? threads : [];
  var tab = (typeof activeThread !== 'undefined' && activeThread) ? activeThread : 'all';
  var oneThread = tab !== 'all';                    // w konkretnym wątku piszesz DOKŁADNIE tam, gdzie patrzysz
  var tabLabel = (tabs.find(function (t) { return t.key === tab; }) || {}).label || 'Ogólne';
  // Kontekst wysyłki: w zakładce wątku = ta zakładka; w „Wszystko" = wątek ostatniej wiadomości.
  var defScope = 'c';
  if (lastMsg) { if (lastMsg.projectId) defScope = 'p:' + lastMsg.projectId; else if (lastMsg.transferId) defScope = 't:' + lastMsg.transferId; }
  if (typeof scopeHint !== 'undefined' && scopeHint) defScope = scopeHint;
  if (oneThread) defScope = tab;
  // Ostrzeżenie w „Wszystko": piszesz gdzie indziej niż ostatnia wiadomość OD KLIENTA.
  var lastIn = null;
  (messages || []).forEach(function (m) { if (m.direction === 'in') lastIn = m; });
  var lastInScope = lastIn ? (lastIn.projectId ? 'p:' + lastIn.projectId : (lastIn.transferId ? 't:' + lastIn.transferId : 'c')) : null;
  var lastInLabel = lastIn ? (lastIn.project ? lastIn.project.name : (lastIn.transfer ? (lastIn.transfer.title || 'Transfer') : 'Ogólne')) : '';
%>
<div class="md:h-[calc(100vh-8rem)] md:flex md:gap-4">
  <!-- LEWA: lista rozmów (klienci) -->
  <aside data-conv-list class="<%= hasSel ? 'hidden md:flex' : 'flex' %> md:w-80 shrink-0 flex-col bg-white rounded-2xl border border-slate-200 overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between gap-2">
      <h2 class="text-sm font-semibold text-slate-700">Rozmowy</h2>
      <% var anyUnread = conversations.some(function (c) { return c.unread > 0; }); %>
      <% if (anyUnread) { %><form method="POST" action="/admin/messages/read-all"><button type="submit" class="text-xs text-brand-700 hover:underline whitespace-nowrap">Przeczytaj wszystkie</button></form><% } %>
    </div>
    <%# „+ Nowa rozmowa": wybór DOWOLNEGO klienta (także bez wiadomości) → otwiera pustą rozmowę z polem pisania. %>
    <div class="px-3 py-2 border-b border-slate-100">
      <select onchange="if(this.value)window.location='/admin/messages?client='+this.value" class="field w-full text-slate-600">
        <option value="">+ Nowa rozmowa — wybierz klienta…</option>
        <% (allClients || []).forEach(function (cl) { %><option value="<%= cl.id %>"><%= cl.name %></option><% }); %>
      </select>
    </div>
    <div class="flex-1 overflow-y-auto divide-y divide-slate-100">
      <% if (!conversations.length) { %><p class="p-6 text-center text-sm text-slate-400">Brak rozmów. Otwórz kartotekę klienta lub projekt, aby napisać jako pierwszy.</p><% } %>
      <% conversations.forEach(function (c) { var cid = c.clientId ? String(c.clientId) : 'none'; var name = c.client ? c.client.name : 'Bez klienta'; var active = selected === cid; %>
        <a href="/admin/messages?client=<%= cid %>" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 transition <%= active ? 'bg-brand-50' : '' %>">
          <%- avatar(c.client || { name: name }, { size: 'md' }) %>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-2">
              <span class="text-sm font-medium text-slate-800 truncate"><%= name %></span>
              <span class="text-[11px] text-slate-400 shrink-0"><%= fmt.date(c.lastAt) %></span>
            </div>
            <div class="flex items-center justify-between gap-2 mt-0.5">
              <span class="text-xs text-slate-400 truncate"><%= (c.lastDir === 'out' ? 'Ty: ' : '') + c.lastBody %></span>
              <% if (c.unread > 0) { %><span class="inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full bg-brand-600 text-white text-[10px] font-bold shrink-0"><%= c.unread %></span><% } %>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </aside>

  <!-- PRAWA: strumień rozmowy -->
  <section class="<%= hasSel ? 'flex' : 'hidden md:flex' %> flex-1 min-w-0 flex-col bg-white rounded-2xl border border-slate-200 overflow-hidden mt-4 md:mt-0">
    <% if (!hasSel) { %>
      <div class="flex-1 flex items-center justify-center text-sm text-slate-400 p-10 text-center">Wybierz rozmowę z listy, aby zobaczyć wiadomości.</div>
    <% } else { %>
      <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2 min-w-0">
          <a href="/admin/messages" class="md:hidden text-slate-400 hover:text-slate-700 shrink-0"><%- icon('arrowLeft', { size: 18, cls: '' }) %></a>
          <%- avatar(convClient || { name: 'Bez klienta' }, { size: 'sm' }) %>
          <span class="font-semibold text-slate-800 truncate"><%= convClient ? convClient.name : 'Bez klienta' %></span>
          <% if (convClient) { %><a href="/admin/clients/<%= convClient.id %>" class="text-xs text-brand-700 hover:underline shrink-0">kartoteka →</a><% } %>
        </div>
        <form method="POST" action="/admin/messages/<%= selected %>/delete" onsubmit="return confirm('Usunąć całą rozmowę?');"><button type="submit" class="text-slate-400 hover:text-red-600 shrink-0" title="Usuń rozmowę"><%- icon('trash', { size: 16, cls: '' }) %></button></form>
      </div>

      <%# Zakładki wątków: to, co widzisz, JEST tym, gdzie piszesz — koniec pomyłek kontekstu
          (wcześniej strumień był scalony, a wysyłka szła w scope z selecta). %>
      <% if (tabs.length > 1 || tab === 'all') { %>
      <div class="px-3 pt-2 pb-1 border-b border-slate-100 flex items-center gap-1.5 overflow-x-auto">
        <% tabs.forEach(function (t) { var on = t.key === tab; %>
          <a href="/admin/messages?client=<%= selected %>&thread=<%= encodeURIComponent(t.key) %>"
             class="shrink-0 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium transition <%= on ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            <%= t.label %>
            <% if (t.unread > 0) { %><span data-thread-badge="<%= t.key %>" class="inline-flex items-center justify-center min-w-[16px] h-4 px-1 rounded-full <%= on ? 'bg-white/25' : 'bg-brand-600 text-white' %> text-[10px] font-bold"><%= t.unread %></span><% } else { %><span data-thread-badge="<%= t.key %>" class="hidden"></span><% } %>
          </a>
        <% }); %>
        <a href="/admin/messages?client=<%= selected %>&thread=all"
           class="shrink-0 rounded-full px-3 py-1 text-xs font-medium transition <%= tab === 'all' ? 'bg-slate-700 text-white' : 'bg-slate-100 text-slate-500 hover:bg-slate-200' %>">Wszystko</a>
      </div>
      <% } %>
      <div id="msg-stream" class="flex-1 overflow-y-auto px-4 py-4 space-y-3"
           data-live-thread data-notify
           data-poll-url="/admin/messages/poll?client=<%= selected %>&thread=<%= encodeURIComponent(tab) %>"
           data-last-id="<%= messages.length ? messages[messages.length - 1].id : 0 %>">
        <% if (!messages.length) { %><p class="text-center text-sm text-slate-400 py-10">Brak wiadomości. Napisz pierwszy — klient dostanie powiadomienie.</p><% } %>
        <% var prevChip = null; %>
        <% messages.forEach(function (m) { %>
          <%- include('_bubble', { m: m, prevChip: prevChip }) %>
          <% prevChip = m.project ? m.project.name : (m.transfer ? (m.transfer.title || 'Transfer') : null); %>
        <% }); %>
      </div>

      <% if (convClient) { %>
      <form method="POST" action="/admin/messages/<%= convClient.id %>/send" enctype="multipart/form-data" data-live-form class="border-t border-slate-100 p-3" x-data="{ fileName: '', body: '' }">
        <%# Kontekst wysyłki + powiadomienie mailem (kompaktowy rząd nad polem). %>
        <div class="flex items-center gap-2 flex-wrap text-xs mb-2">
          <% if (oneThread) { %>
            <%# Zakładka wątku = jedyne możliwe miejsce wysyłki. Brak selecta = brak pomyłki. %>
            <input type="hidden" name="scope" value="<%= tab %>" />
            <span class="inline-flex items-center gap-1.5 text-slate-500">Piszesz w: <span class="font-medium text-slate-700"><%= tabLabel %></span></span>
          <% } else { %>
            <label class="text-slate-500">Kontekst:</label>
            <select name="scope" class="field text-xs text-slate-700">
              <option value="c" <%= defScope === 'c' ? 'selected' : '' %>>Ogólne</option>
              <% (projects || []).forEach(function (p) { %><option value="p:<%= p.id %>" <%= defScope === 'p:' + p.id ? 'selected' : '' %>>Projekt: <%= p.name %></option><% }); %>
              <% Object.keys(threadTransfers).forEach(function (tid) { %><option value="t:<%= tid %>" <%= defScope === 't:' + tid ? 'selected' : '' %>>Transfer: <%= threadTransfers[tid] %></option><% }); %>
            </select>
          <% } %>
          <label class="inline-flex items-center gap-1.5 text-slate-500 ml-auto"><input type="checkbox" name="notify" checked class="rounded border-slate-300" /> Powiadom mailem<% if (!convClient.email) { %> <span class="text-slate-300">(brak e-maila)</span><% } %></label>
        </div>
        <% if (!oneThread && lastInScope && lastInScope !== defScope) { %>
          <div class="alert alert-warn mb-2 items-start gap-1.5 text-xs">
            <%- icon('alert', { size: 13, cls: 'mt-0.5 shrink-0' }) %>
            <span>Piszesz w innym wątku niż ostatnia wiadomość klienta (<b><%= lastInLabel %></b>) — klient zobaczy ją w innym miejscu.
              <a href="/admin/messages?client=<%= selected %>&thread=<%= encodeURIComponent(lastInScope) %>" class="underline font-medium">Przejdź do tamtego wątku</a></span>
          </div>
        <% } %>
        <%# Chip wybranego pliku (po wyborze) + „×" czyszczący input. %>
        <div x-show="fileName" x-cloak class="mb-2 flex items-center gap-2 text-xs text-slate-600">
          <%- icon('file', { size: 13, cls: 'text-brand-600 shrink-0' }) %><span class="truncate max-w-[240px]" x-text="fileName"></span>
          <button type="button" @click="fileName=''; $refs.att.value=''" class="text-slate-400 hover:text-red-600 shrink-0" aria-label="Usuń załącznik"><%- icon('x', { size: 13, cls: '' }) %></button>
        </div>
        <%# Composer: „dołącz" (chmura) | pole z ikoną wysyłki WEWNĄTRZ (wyszarzona, gdy nic nie
            napisano; brandowa, gdy jest treść albo załącznik) — jak w ChatGPT/Linear. %>
        <div class="flex items-end gap-2">
          <label class="shrink-0 w-10 h-10 rounded-lg text-slate-400 hover:text-brand-600 hover:bg-slate-100 flex items-center justify-center cursor-pointer transition" title="Dołącz plik" aria-label="Dołącz plik">
            <input type="file" name="attachment" class="hidden" x-ref="att" @change="fileName = $event.target.files.length ? $event.target.files[0].name : ''" />
            <%- icon('cloudUpload', { size: 20, cls: '' }) %>
          </label>
          <div class="relative flex-1">
            <textarea name="body" x-model="body" :required="!fileName" rows="1" maxlength="4000" placeholder="Napisz wiadomość…" data-enter-send
              class="field block w-full resize-none rounded-2xl pl-4 pr-14 leading-5"></textarea>
            <%# Przycisk = zaokrąglony prostokąt wpisany w pole: RÓWNY odstęp 6 px od górnej,
                prawej i dolnej krawędzi (`inset-y-1.5 right-1.5`), więc rośnie razem z polem. %>
            <button type="submit" title="Wyślij" aria-label="Wyślij"
                    :class="(body.trim() || fileName) ? 'btn-primary shadow-sm' : 'text-slate-300 hover:text-brand-600 hover:bg-brand-50'"
                    class="absolute right-1.5 top-1.5 bottom-1.5 w-9 rounded-xl flex items-center justify-center transition"><%- icon('send', { size: 17, cls: '' }) %></button>
          </div>
        </div>
      </form>
      <% } %>
    <% } %>
  </section>
</div>

<script>
  // Auto-scroll strumienia na dół (najnowsze widoczne).
  (function () { var s = document.getElementById('msg-stream'); if (s) s.scrollTop = s.scrollHeight; })();
  // Enter wysyła wiadomość, Shift+Enter = nowa linia (jak w komunikatorze).
  (function () {
    var t = document.querySelector('textarea[data-enter-send]');
    if (!t) return;
    t.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); t.form.requestSubmit(); }
    });
  })();
</script>
