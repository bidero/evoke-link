<%
  const pName = (profile && profile.name) ? profile.name : '';
  const pInitial = ((pName || email || '?').trim().charAt(0) || '?').toUpperCase();
%>
<div class="max-w-3xl space-y-6">
  <% if (savedProfile) { %>
    <div class="flex items-center gap-2 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm px-3 py-2">
      <%- icon('check', { size: 16, cls: 'text-green-600' }) %> Profil zapisany.
    </div>
  <% } %>
  <% if (saved) { %>
    <div class="flex items-center gap-2 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm px-3 py-2">
      <%- icon('check', { size: 16, cls: 'text-green-600' }) %> Hasło zostało zmienione.
    </div>
  <% } %>
  <% if (error) { %>
    <div class="rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-3 py-2"><%= error %></div>
  <% } %>

  <!-- PROFIL -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6">
    <h2 class="text-base font-semibold text-slate-800 mb-5">Mój profil</h2>
    <div class="flex items-center gap-4 mb-6">
      <% if (profile && profile.avatarPath) { %>
        <img src="<%= profile.avatarPath %>" alt="Avatar" class="w-16 h-16 rounded-full object-cover border border-slate-200" />
      <% } else { %>
        <div class="w-16 h-16 rounded-full bg-brand-50 text-brand-700 flex items-center justify-center text-2xl font-semibold"><%= pInitial %></div>
      <% } %>
      <div class="min-w-0">
        <div class="text-lg font-semibold text-slate-800 truncate"><%= pName || 'Administrator' %></div>
        <div class="text-sm text-slate-500 truncate">
          <%= (profile && profile.role) ? profile.role : 'Konto agencji' %>
          <span class="text-slate-300">·</span> <%= email %>
        </div>
      </div>
    </div>

    <form method="POST" action="/admin/account/profile" enctype="multipart/form-data" class="space-y-4" x-data="{ avatar: '' }">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Imię i nazwisko / nazwa</label>
          <input name="name" type="text" value="<%= pName %>" maxlength="120" placeholder="np. Radek Biedermann"
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Rola / stanowisko</label>
          <input name="role" type="text" value="<%= (profile && profile.role) ? profile.role : '' %>" maxlength="120" placeholder="np. Właściciel"
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Telefon</label>
          <input name="phone" type="text" value="<%= (profile && profile.phone) ? profile.phone : '' %>" maxlength="60" placeholder="np. 600 100 200"
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">E-mail logowania</label>
          <input type="text" value="<%= email %>" disabled
                 class="w-full rounded-lg border border-slate-200 bg-slate-50 text-slate-400 px-3 py-2 text-sm outline-none cursor-not-allowed" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Avatar <span class="text-slate-400 font-normal">(kwadrat, PNG/JPG/SVG)</span></label>
        <div class="flex items-center gap-3 flex-wrap">
          <label class="inline-flex items-center gap-1.5 rounded-lg border border-dashed border-slate-300 px-3 py-2 text-sm text-slate-600 cursor-pointer hover:bg-brand-50 hover:text-brand-700 hover:border-brand-300 transition">
            <%- icon('cloudUpload', { size: 16, cls: '' }) %> Wgraj avatar
            <input type="file" name="avatar" accept="image/*" class="hidden" @change="avatar = $event.target.files.length ? $event.target.files[0].name : ''" />
          </label>
          <span class="text-xs text-slate-500 truncate max-w-[220px]" x-show="avatar" x-cloak x-text="avatar"></span>
          <% if (profile && profile.avatarPath) { %>
            <label class="inline-flex items-center gap-1.5 text-xs text-slate-500"><input type="checkbox" name="removeAvatar" value="1" class="rounded border-slate-300" /> Usuń obecny avatar</label>
          <% } %>
        </div>
      </div>
      <button type="submit" class="rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-medium px-5 py-2.5 text-sm transition">Zapisz profil</button>
    </form>
  </div>

  <!-- BEZPIECZEŃSTWO -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6">
    <h2 class="text-base font-semibold text-slate-800 mb-1">Bezpieczeństwo</h2>
    <p class="text-xs mb-5 <%= usingDbPassword ? 'text-slate-400' : 'text-amber-600' %>">
      <% if (usingDbPassword) { %>Hasło ustawione w panelu (zapisane w bazie).<% } else { %>Logowanie korzysta z hasła z pliku .env. Ustaw nowe hasło poniżej, aby zarządzać nim z panelu.<% } %>
    </p>

    <form method="POST" action="/admin/account/password" class="space-y-4 max-w-md">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1" for="currentPassword">Obecne hasło</label>
        <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password"
               class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1" for="newPassword">Nowe hasło <span class="text-slate-400 font-normal">(min. 8)</span></label>
          <input id="newPassword" name="newPassword" type="password" required minlength="8" autocomplete="new-password"
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1" for="confirmPassword">Powtórz nowe hasło</label>
          <input id="confirmPassword" name="confirmPassword" type="password" required minlength="8" autocomplete="new-password"
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
        </div>
      </div>
      <button type="submit" class="rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-medium px-5 py-2.5 text-sm transition">Zmień hasło</button>
    </form>

    <%# ── Passkeys (WebAuthn) ────────────────────────────────────────────── %>
    <div class="border-t border-slate-100 mt-6 pt-5" x-data="{ busy: false, err: '', label: '' }">
      <div class="flex items-start justify-between gap-3 flex-wrap">
        <div>
          <div class="text-sm font-medium text-slate-700">Klucze dostępu (passkeys)</div>
          <div class="text-xs text-slate-400">
            <% if (!canUse2fa) { %>
              Wymaga konta w bazie — ustaw hasło w panelu, aby dodać klucz.
            <% } else if (!passkeysSupported) { %>
              Wymagają połączenia HTTPS. Na produkcji (<%= appUrlHost %>) zadziałają; lokalnie działa tylko <code>localhost</code>.
            <% } else { %>
              Logowanie odciskiem palca / Face ID lub kluczem z menedżera haseł — bez wpisywania hasła.
            <% } %>
          </div>
        </div>
        <% if (canUse2fa && passkeysSupported) { %>
          <button type="button" x-show="window.evokePasskey && window.evokePasskey.supported()" x-cloak
                  :disabled="busy"
                  @click="err=''; busy=true; window.evokePasskey.register(label).then(()=>location.reload()).catch(e=>{ err = e.message || 'Nie udało się dodać klucza.'; busy=false; })"
                  class="rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 transition disabled:opacity-60">
            <span x-show="!busy">Dodaj passkey</span><span x-show="busy" x-cloak>Czekam na urządzenie…</span>
          </button>
        <% } %>
      </div>
      <p x-show="err" x-cloak x-text="err" class="mt-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-3 py-2"></p>

      <% if (passkeys && passkeys.length) { %>
        <div class="mt-3 divide-y divide-slate-100 rounded-xl border border-slate-200">
          <% passkeys.forEach(function(k){ %>
            <div class="flex items-center gap-3 px-3 py-2.5">
              <span class="shrink-0 text-slate-400"><%- icon('lock', { size: 16, cls: '' }) %></span>
              <div class="min-w-0 flex-1">
                <div class="text-sm text-slate-800 truncate"><%= k.label || 'Passkey' %></div>
                <div class="text-[11px] text-slate-400">
                  dodany <%= fmt.date(k.createdAt) %><% if (k.lastUsedAt) { %> · ostatnio użyty <%= fmt.date(k.lastUsedAt) %><% } %>
                </div>
              </div>
              <form method="POST" action="/admin/account/passkey/<%= k.id %>/delete" onsubmit="return confirm('Usunąć ten klucz?');">
                <button type="submit" class="text-slate-300 hover:text-red-600 p-1" title="Usuń klucz"><%- icon('trash', { size: 15, cls: '' }) %></button>
              </form>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <%# ── 2FA (TOTP) ─────────────────────────────────────────────────────── %>
    <div class="border-t border-slate-100 mt-6 pt-5">
      <div class="flex items-start justify-between gap-3 flex-wrap">
        <div>
          <div class="text-sm font-medium text-slate-700">Uwierzytelnianie dwuetapowe (2FA)</div>
          <div class="text-xs text-slate-400">
            <% if (twoFaOn) { %>
              Włączone — przy logowaniu poprosimy o kod z aplikacji.
              <span class="text-slate-500">Kody zapasowe: <%= recoveryLeft %></span>
            <% } else if (!canUse2fa) { %>
              Wymaga konta w bazie. Ustaw hasło w panelu (powyżej) — wtedy 2FA stanie się dostępne.
            <% } else { %>
              Dodatkowy kod z aplikacji (Apple Passwords, Google Authenticator, 1Password) przy logowaniu.
            <% } %>
          </div>
        </div>
        <% if (canUse2fa && !twoFaOn && !setupSecret) { %>
          <form method="POST" action="/admin/account/2fa/start">
            <button type="submit" class="rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 transition">Włącz 2FA</button>
          </form>
        <% } %>
        <% if (twoFaOn) { %>
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 bg-green-50 px-2.5 py-1 rounded-full"><%- icon('check', { size: 13, cls: '' }) %> Aktywne</span>
        <% } %>
      </div>

      <% if (setupSecret) { %>
        <%# Krok konfiguracji: QR + sekret + potwierdzenie kodem. %>
        <div class="mt-4 rounded-xl border border-slate-200 p-4">
          <p class="text-sm text-slate-600 mb-3">1. Zeskanuj kod w aplikacji uwierzytelniającej (albo wpisz sekret ręcznie). 2. Przepisz wygenerowany 6-cyfrowy kod, żeby potwierdzić.</p>
          <div class="flex items-start gap-5 flex-wrap">
            <%# QR skalowany do kontenera — `qr.svg` ma naturalny rozmiar (util współdzielony z QR przelewu). %>
            <div class="shrink-0 rounded-lg border border-slate-200 p-2 bg-white w-44 [&>svg]:w-full [&>svg]:h-auto [&>svg]:block"><%- setupQr %></div>
            <div class="min-w-0 flex-1">
              <div class="text-[11px] font-medium text-slate-500 mb-1">Sekret (gdy nie możesz zeskanować)</div>
              <code class="block text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 break-all"><%= setupSecret %></code>
              <form method="POST" action="/admin/account/2fa/confirm" class="mt-3 flex items-end gap-2 flex-wrap">
                <label class="block">
                  <span class="block text-[11px] font-medium text-slate-500 mb-1">Kod z aplikacji</span>
                  <input name="token" required autofocus inputmode="numeric" autocomplete="one-time-code" placeholder="123456"
                         class="w-36 rounded-lg border border-slate-300 px-3 py-2 text-sm tracking-widest focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
                </label>
                <button type="submit" class="rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 transition">Potwierdź i włącz</button>
              </form>
            </div>
          </div>
        </div>
      <% } %>

      <% if (newCodes && newCodes.length) { %>
        <%# Kody zapasowe — pokazywane JEDEN raz (w bazie tylko hashe). %>
        <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4">
          <div class="text-sm font-semibold text-amber-900">Zapisz kody zapasowe</div>
          <p class="text-xs text-amber-800 mt-1 mb-3">Pokazujemy je tylko teraz. Każdy działa raz — użyj, gdy nie masz dostępu do aplikacji (np. zgubiony telefon).</p>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
            <% newCodes.forEach(function(c){ %><code class="text-center text-sm bg-white border border-amber-200 rounded-lg px-2 py-1.5 tracking-wider"><%= c %></code><% }); %>
          </div>
        </div>
      <% } %>

      <% if (twoFaOn) { %>
        <div class="mt-4 flex items-center gap-3 flex-wrap">
          <form method="POST" action="/admin/account/2fa/recovery" onsubmit="return confirm('Wygenerować nowe kody zapasowe? Poprzednie przestaną działać.');">
            <button type="submit" class="rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50 text-sm px-4 py-2 transition">Nowe kody zapasowe</button>
          </form>
          <form method="POST" action="/admin/account/2fa/disable" class="flex items-end gap-2" onsubmit="return confirm('Wyłączyć uwierzytelnianie dwuetapowe?');">
            <label class="block">
              <span class="block text-[11px] font-medium text-slate-500 mb-1">Hasło (potwierdzenie)</span>
              <input name="password" type="password" required autocomplete="current-password" class="w-44 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
            </label>
            <button type="submit" class="rounded-lg border border-red-200 text-red-600 hover:bg-red-50 text-sm px-4 py-2 transition">Wyłącz 2FA</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <!-- STREFA RYZYKA -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6">
    <h2 class="text-base font-semibold text-slate-800 mb-4">Sesja</h2>
    <div class="flex items-center justify-between gap-3">
      <div>
        <div class="text-sm font-medium text-slate-700">Wyloguj z panelu</div>
        <div class="text-xs text-slate-400">Zakończ bieżącą sesję w tej przeglądarce.</div>
      </div>
      <form method="POST" action="/admin/logout">
        <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50 px-4 py-2 text-sm transition"><%- icon('arrowRight', { size: 15, cls: '' }) %> Wyloguj</button>
      </form>
    </div>
  </div>
</div>
