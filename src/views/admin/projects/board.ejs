<div class="flex items-center justify-between mb-5 gap-3 flex-wrap">
  <p class="text-sm text-slate-500">Przeciągnij projekt między kolumnami, aby zmienić etap — zapisuje się automatycznie.</p>
  <div class="flex items-center gap-3">
    <a href="/admin/projects/new" class="btn btn-primary"><%- icon('plus', { size: 15, cls: '' }) %> Nowy projekt</a>
    <a href="/admin/projects" class="text-sm text-brand-700 hover:underline whitespace-nowrap">Widok listy →</a>
  </div>
</div>

<%
  const COL_ACCENT = { lead: 'border-t-sky-400', active: 'border-t-brand-500', delivered: 'border-t-amber-400', paid: 'border-t-green-500' };
  const COL_DOT = { lead: 'bg-sky-400', active: 'bg-brand-500', delivered: 'bg-amber-400', paid: 'bg-green-500' };
%>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
  <% columns.forEach(function(col){ %>
    <div class="bg-slate-50/80 rounded-2xl border border-slate-200 border-t-4 <%= COL_ACCENT[col.stage] %> flex flex-col min-h-[220px]">
      <div class="px-4 py-3">
        <div class="flex items-center justify-between gap-2">
          <span class="text-sm font-semibold text-slate-700 inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full <%= COL_DOT[col.stage] %>"></span> <%= col.label %></span>
          <span class="text-xs text-slate-400"><%= col.projects.length %></span>
        </div>
        <%# Podsumowanie etapu: ile pieniędzy czeka w tej kolumnie (brutto). %>
        <% if (col.outstanding > 0) { %>
          <div class="mt-1 text-xs text-slate-500">do zapłaty: <span class="font-medium text-slate-700"><%= fmt.money(col.outstanding) %></span></div>
          <% if (col.overdue > 0) { %><div class="text-xs font-medium text-red-600"><%= fmt.money(col.overdue) %> po terminie</div><% } %>
        <% } %>
      </div>
      <div class="board-col flex-1 px-3 pb-3 space-y-2" data-stage="<%= col.stage %>">
        <% col.projects.forEach(function(p){ %>
          <div class="bg-white rounded-xl border border-slate-200 p-3 shadow-sm cursor-grab hover:border-brand-300 transition" data-id="<%= p.id %>">
            <div class="flex items-start gap-2">
              <a href="/admin/projects/<%= p.id %>?from=board" class="flex-1 min-w-0 text-sm font-medium text-slate-800 hover:text-brand-700 truncate" draggable="false"><%= p.name %></a>
              <% if (p.unreadMessages > 0) { %>
                <span class="shrink-0 inline-flex items-center gap-0.5 text-[11px] font-medium text-brand-700 bg-brand-50 px-1.5 py-0.5 rounded-full" title="Nieprzeczytane wiadomości"><%- icon('mail', { size: 11, cls: '' }) %> <%= p.unreadMessages %></span>
              <% } %>
            </div>
            <div class="mt-1 flex items-center justify-between gap-2 text-xs text-slate-400">
              <span class="flex items-center gap-1.5 min-w-0">
                <% if (p.client) { %><%- avatar(p.client, { size: 'xs' }) %><% } %>
                <span class="truncate"><%= p.client ? p.client.name : (p.clientName || '—') %></span>
              </span>
              <span class="shrink-0"><%= p._count.transfers %> transf.</span>
            </div>
            <% if (p.outstanding > 0) { %>
              <div class="mt-1.5 text-xs font-medium <%= p.overdue > 0 ? 'text-red-600' : (col.stage === 'paid' ? 'text-amber-600' : 'text-slate-600') %>">
                do zapłaty: <%= fmt.money(p.outstanding) %><% if (p.overdue > 0) { %> · po terminie<% } %>
              </div>
            <% } %>
          </div>
        <% }); %>
        <% if (!col.projects.length) { %>
          <p class="text-xs text-slate-300 text-center py-8">Przeciągnij tu projekt</p>
        <% } %>
      </div>
    </div>
  <% }); %>
</div>

<script src="/js/sortable.min.js"></script>
<script>
  (function () {
    if (!window.Sortable) return;
    document.querySelectorAll('.board-col').forEach(function (col) {
      Sortable.create(col, {
        group: 'board',
        animation: 150,
        ghostClass: 'opacity-50',
        filter: 'a', // klik w nazwę projektu otwiera go, nie startuje przeciągania
        preventOnFilter: false,
        onAdd: function (evt) {
          var id = evt.item.getAttribute('data-id');
          var stage = evt.to.getAttribute('data-stage');
          fetch('/admin/projects/' + id + '/stage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ stage: stage }),
          }).then(function () { location.reload(); }).catch(function () { location.reload(); });
        },
      });
    });
  })();
</script>
