<div class="max-w-xl">
  <% if (error) { %>
    <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-3 py-2"><%= error %></div>
  <% } %>
  <form method="POST" action="/admin/projects" class="space-y-5 bg-white rounded-2xl border border-slate-200 p-6">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Nazwa projektu *</label>
      <input name="name" type="text" required placeholder="np. Billboard dla marki odzieżowej"
             class="field" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Klient (z bazy)</label>
      <select name="clientId" class="field">
        <option value="">— brak / spoza bazy —</option>
        <% clients.forEach(function(c){ %><option value="<%= c.id %>" <%= (typeof selectedClientId !== 'undefined' && selectedClientId === c.id) ? 'selected' : '' %>><%= c.name %><%= c.email ? ' (' + c.email + ')' : '' %></option><% }); %>
      </select>
      <p class="text-xs text-slate-400 mt-1"><a href="/admin/clients/new" class="text-brand-700 hover:underline">+ dodaj klienta do bazy</a></p>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">…lub nazwa klienta (wolny tekst)</label>
      <input name="clientName" type="text" placeholder="np. Marka XYZ"
             class="field" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Opis (opcjonalnie)</label>
      <textarea name="description" rows="3"
                class="field"></textarea>
    </div>
    <% if (typeof templates !== 'undefined' && templates.length) { %>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Szablon (opcjonalnie)</label>
        <select name="templateId" class="field">
          <option value="">— bez szablonu —</option>
          <% templates.forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %><%= t.description ? ' — ' + t.description : '' %></option><% }); %>
        </select>
        <p class="text-xs text-slate-400 mt-1">Rozstawi listę braków i przypomnienia z szablonu. <a href="/admin/projects/templates" class="text-brand-700 hover:underline">Zarządzaj szablonami</a></p>
      </div>
    <% } %>
    <div class="flex items-center gap-3">
      <button type="submit" class="btn btn-lg btn-primary">Utwórz projekt</button>
      <a href="/admin/projects" class="text-sm text-slate-500 hover:text-slate-700">Anuluj</a>
    </div>
  </form>
</div>
