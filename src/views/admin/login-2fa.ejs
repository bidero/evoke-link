<%
  const appName = (typeof settings !== 'undefined' && settings) ? settings.appName : 'Evoke LINK';
  const dark = (typeof loginBgDark !== 'undefined') ? loginBgDark : (typeof bgDark !== 'undefined' && bgDark);
%>
<div class="w-full max-w-sm">
  <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/10 p-8">
    <div class="w-11 h-11 rounded-full bg-brand-50 text-brand-700 inline-flex items-center justify-center mb-4"><%- icon('lock', { size: 20, cls: '' }) %></div>
    <h1 class="text-xl font-semibold mb-1">Weryfikacja dwuetapowa</h1>
    <p class="text-sm text-slate-500 mb-6">Wpisz 6-cyfrowy kod z aplikacji uwierzytelniającej. Możesz też użyć kodu zapasowego.</p>

    <% if (error) { %>
      <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-3 py-2"><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/login/2fa" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1" for="token">Kod</label>
        <input id="token" name="token" type="text" required autofocus autocomplete="one-time-code" inputmode="numeric"
               placeholder="123456 lub kod zapasowy"
               class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm tracking-widest focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
      </div>
      <button type="submit" class="w-full rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-medium py-2.5 text-sm transition">Zweryfikuj</button>
    </form>

    <form method="POST" action="/admin/logout" class="mt-4 text-center">
      <button type="submit" class="text-xs text-slate-400 hover:text-slate-600">Zaloguj się na inne konto</button>
    </form>
  </div>
  <p class="text-center text-xs mt-6 <%= dark ? 'text-white/80' : 'text-slate-500' %>"><%= appName %></p>
</div>
