<%# Widżet wykresu przychodu (6 miesięcy) — dane z pulse().money.chart (bez nowego zapytania).
    Sam wykres + przełącznik linia/słupki siedzą we wspólnym partialu `admin/_revenue_chart`
    (ten sam kod używa strona Puls); rysownik: public/js/chart.js. %>
<div class="h-full flex flex-col bg-white rounded-2xl border border-slate-200 overflow-hidden">
  <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between gap-2">
    <h2 class="text-sm font-medium text-slate-700 inline-flex items-center gap-1.5"><%- icon(typeof wicon !== 'undefined' ? wicon : 'trendingUp', { size: 15, cls: 'text-slate-400' }) %> Przychód — 6 miesięcy</h2>
  </div>
  <div class="flex-1 min-h-0 overflow-y-auto p-5">
    <% if (!pulse) { %>
      <p class="py-4 text-center text-sm text-slate-400">Brak danych.</p>
    <% } else { %>
      <%- include('../_revenue_chart', { chartData: pulse.money.chart, storeKey: 'evoke-chart-type' }) %>
      <div class="mt-2 flex items-baseline justify-between gap-2">
        <span class="text-xs text-slate-400">w tym miesiącu</span>
        <span class="text-lg font-semibold tracking-tight"><%= fmt.money(pulse.money.paidThisMonth) %></span>
      </div>
    <% } %>
  </div>
</div>
