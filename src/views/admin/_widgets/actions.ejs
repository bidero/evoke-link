<div class="h-full bg-white rounded-2xl border border-slate-200 p-5">
  <h2 class="text-sm font-medium text-slate-700 mb-3 inline-flex items-center gap-1.5"><%- icon(typeof wicon !== 'undefined' ? wicon : 'plus', { size: 15, cls: 'text-slate-400' }) %> Szybkie akcje</h2>
  <div class="space-y-2">
    <% const _acts = (typeof quickActions !== 'undefined' && quickActions) ? quickActions : []; %>
    <% if (!_acts.length) { %>
      <p class="text-sm text-slate-400 py-2">Brak akcji — dodaj w Ustawienia → Panel.</p>
    <% } %>
    <% _acts.forEach(function(a){ %>
      <a href="<%= a.href %>" class="block rounded-lg text-sm font-medium px-4 py-2.5 text-center transition <%= a.primary ? 'bg-brand-600 hover:bg-brand-700 text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50' %>"><%= a.label %></a>
    <% }); %>
  </div>
</div>
