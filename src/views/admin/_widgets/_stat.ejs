<%# Kafelek KPI. Kompozycja jak w referencji (TailAdmin): badge ikony u góry, pod nim
    etykieta i wartość. Kafelek ma NATURALNĄ wysokość (grid: `self-start` w dashboard.ejs),
    więc nie rozciąga się do wysokości sąsiedniego, wysokiego widżetu. %>
<% const _ic = typeof wicon !== 'undefined' && wicon ? wicon : null; %>
<% const _inner = `
    ${_ic ? `<span data-stat-icon class="text-slate-300 group-hover:text-brand-400 transition">${icon(_ic, { size: 18, cls: '' })}</span>` : ''}
    <div class="${_ic ? 'mt-4' : ''}">
      <div class="text-sm text-slate-500">${tile.label}</div>
      <div class="mt-1 text-3xl font-semibold tracking-tight ${tile.valueCls || ''}">${tile.value}</div>
      <div class="mt-1 text-xs text-slate-400">${tile.hint}</div>
    </div>` %>
<% if (tile.href) { %>
  <a href="<%= tile.href %>" class="block bg-white rounded-2xl border border-slate-200 p-5 hover:border-brand-300 hover:shadow-sm transition group"><%- _inner %></a>
<% } else { %>
  <div class="bg-white rounded-2xl border border-slate-200 p-5"><%- _inner %></div>
<% } %>
