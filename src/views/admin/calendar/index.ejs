<%
  const pad = (n) => String(n).padStart(2, '0');
  const dtLocal = (d) => { const x = new Date(d); return `${x.getFullYear()}-${pad(x.getMonth() + 1)}-${pad(x.getDate())}T${pad(x.getHours())}:${pad(x.getMinutes())}`; };
  function colorCls(c) {
    switch (c) {
      case 'sky': return 'bg-sky-50 text-sky-700';
      case 'emerald': return 'bg-emerald-50 text-emerald-700';
      case 'amber': return 'bg-amber-50 text-amber-700';
      case 'rose': return 'bg-rose-50 text-rose-700';
      case 'violet': return 'bg-violet-50 text-violet-700';
      case 'slate': return 'bg-slate-100 text-slate-600';
      default: return null;
    }
  }
  function chipCls(e) {
    if (e.done) return 'bg-slate-100 text-slate-400 line-through';
    if (e.kind === 'reminder') {
      var cc = colorCls(e.color); // własny kolor przypomnienia ma pierwszeństwo
      if (cc) return cc;
      return e.priority === 'high' ? 'bg-red-50 text-red-700' : (e.priority === 'low' ? 'bg-slate-100 text-slate-600' : 'bg-brand-50 text-brand-700');
    }
    if (e.kind === 'charge') return 'bg-amber-50 text-amber-700';
    if (e.kind === 'transfer') return 'bg-sky-50 text-sky-700';
    return 'bg-slate-100 text-slate-600';
  }
  // Swatche kolorów w modalu (wartość → klasa tła kółka).
  var COLOR_SWATCH = { sky: 'bg-sky-500', emerald: 'bg-emerald-500', amber: 'bg-amber-500', rose: 'bg-rose-500', violet: 'bg-violet-500', slate: 'bg-slate-400' };
  // Wszystkie renderowane dni (miesiąc = weeks, tydzień/dzień = days) w jedną listę.
  const allDays = [];
  if (typeof weeks !== 'undefined' && weeks) weeks.forEach((w) => w.forEach((d) => allDays.push(d)));
  if (typeof days !== 'undefined' && days) days.forEach((d) => allDays.push(d));
  // Mapy dla klienta (Alpine): przypomnienia (do edycji) + wydarzenia po dniu (panel dnia).
  const remAll = [];
  allDays.forEach((d) => d.events.forEach((e) => { if (e.kind === 'reminder') remAll.push(e); }));
  upcoming.forEach((e) => { if (e.kind === 'reminder') remAll.push(e); });
  doneReminders.forEach((e) => remAll.push(e));
  const remindersMap = {};
  remAll.forEach((e) => { remindersMap[e.id] = { id: e.id, title: e.title, note: e.note || '', dueAt: dtLocal(e.date), endAt: e.durationMin ? dtLocal(new Date(new Date(e.date).getTime() + e.durationMin * 60000)) : '', priority: e.priority || 'normal', color: e.color || '', clientId: e.clientId == null ? '' : e.clientId, projectId: e.projectId == null ? '' : e.projectId, href: e.href || '', done: !!e.done, seriesId: e.seriesId || '' }; });
  const eventsByDayMap = {};
  allDays.forEach((d) => { if (d.events.length) eventsByDayMap[d.key] = d.events.map((e) => ({ kind: e.kind, id: e.id, title: e.title, done: !!e.done, href: e.href || '', priority: e.priority || 'normal' })); });
  const jsonJs = (x) => JSON.stringify(x).replace(/</g, '\\u003c');
  // Czas HH:MM zdarzenia (widok dnia/tygodnia).
  const evTime = (d) => { const x = new Date(d); return `${pad(x.getHours())}:${pad(x.getMinutes())}`; };
  // Hidden inputy zachowujące widok po zapisie (miesiąc/tydzień/dzień).
%>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6" x-data="calendar()" x-init="$watch('sideOpen', v => { try { localStorage.setItem('evoke-cal-side', v ? '1' : '0'); } catch(e){} })">

  <!-- KALENDARZ -->
  <div :class="sideOpen ? 'lg:col-span-2' : 'lg:col-span-3'">
    <div class="flex items-center justify-between mb-3 gap-2 flex-wrap">
      <div class="flex items-center gap-2">
        <a href="<%= prevLink %>" class="w-8 h-8 inline-flex items-center justify-center rounded-lg border border-slate-300 text-slate-500 hover:bg-slate-50" aria-label="Poprzedni"><%- icon('arrowLeft', { size: 16, cls: '' }) %></a>
        <h2 class="text-base font-semibold text-slate-800 capitalize min-w-[150px] text-center"><%= label %></h2>
        <a href="<%= nextLink %>" class="w-8 h-8 inline-flex items-center justify-center rounded-lg border border-slate-300 text-slate-500 hover:bg-slate-50" aria-label="Następny"><%- icon('arrowRight', { size: 16, cls: '' }) %></a>
        <% if (!isToday) { %><a href="<%= todayLink %>" class="ml-1 text-sm text-brand-700 hover:underline">Dziś</a><% } %>
      </div>
      <div class="flex items-center gap-2">
        <%# Zwiń/rozwiń panel boczny (Nadchodzące/Zrobione) — kalendarz na pełną szerokość. %>
        <button type="button" @click="sideOpen = !sideOpen" :title="sideOpen ? 'Zwiń panel — szerszy kalendarz' : 'Rozwiń panel'" class="w-8 h-8 hidden lg:inline-flex items-center justify-center rounded-lg border border-slate-300 text-slate-500 hover:bg-slate-50">
          <span x-show="sideOpen"><%- icon('arrowRight', { size: 16, cls: '' }) %></span>
          <span x-show="!sideOpen" x-cloak><%- icon('arrowLeft', { size: 16, cls: '' }) %></span>
        </button>
        <%# Przełącznik widoku: miesiąc / tydzień / dzień (data referencyjna = viewDate). %>
        <div class="inline-flex rounded-lg border border-slate-300 overflow-hidden text-sm">
          <a href="/admin/calendar?month=<%= curMonth %>" class="px-3 py-1.5 <%= view === 'month' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-50' %>">Miesiąc</a>
          <a href="/admin/calendar?view=week&date=<%= viewDate %>" class="px-3 py-1.5 border-l border-slate-300 <%= view === 'week' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-50' %>">Tydzień</a>
          <a href="/admin/calendar?view=day&date=<%= viewDate %>" class="px-3 py-1.5 border-l border-slate-300 <%= view === 'day' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-50' %>">Dzień</a>
        </div>
        <button type="button" @click="openNew('<%= viewDate %>')" class="btn btn-sm btn-primary"><%- icon('plus', { size: 15, cls: '' }) %> <span class="hidden sm:inline">Przypomnienie</span></button>
      </div>
    </div>

    <% if (view === 'month') { %>
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
      <div data-cal-head class="grid grid-cols-7 text-center text-[11px] font-medium text-slate-400 border-b border-slate-100">
        <% ['Pn','Wt','Śr','Cz','Pt','So','Nd'].forEach(function(d){ %><div class="py-2"><%= d %></div><% }); %>
      </div>
      <% weeks.forEach(function(week){ %>
        <div class="grid grid-cols-7">
          <% week.forEach(function(day){ %>
            <div data-cal-cell <%= day.isToday ? 'data-today' : '' %> class="min-h-[92px] border-r border-b border-slate-100 last:border-r-0 p-1.5 cursor-pointer hover:bg-slate-50/60 <%= day.inMonth ? '' : 'bg-slate-50/60' %>"
                 @click="openNew('<%= day.key %>')" @contextmenu.prevent="openMenu($event, { type: 'day', key: '<%= day.key %>' })">
              <div class="flex justify-end">
                <span @click.stop="openDay('<%= day.key %>')" class="text-[11px] inline-flex items-center justify-center w-5 h-5 rounded-full cursor-pointer <%= day.isToday ? 'bg-brand-600 text-white font-semibold' : (day.inMonth ? 'text-slate-500 hover:bg-slate-100' : 'text-slate-300') %>"><%= day.day %></span>
              </div>
              <div class="mt-0.5 space-y-0.5 cal-events min-h-[44px]" data-day="<%= day.key %>">
                <% day.events.slice(0, 3).forEach(function(e){ %>
                  <% if (e.kind === 'reminder') { %>
                    <button type="button" title="<%= e.title %>" data-remid="<%= e.id %>" @click.stop="openEdit(REM[<%= e.id %>])" @contextmenu.prevent.stop="openMenu($event, { type: 'reminder', id: <%= e.id %> })" class="cal-chip block w-full text-left truncate rounded px-1 py-0.5 text-[10px] leading-tight cursor-grab <%= chipCls(e) %>"><%= e.title %></button>
                  <% } else { %>
                    <a href="<%= e.href %>" title="<%= e.title %>" @click.stop @contextmenu.prevent.stop="openMenu($event, { type: '<%= e.kind %>', id: <%= e.id %>, href: '<%= e.href %>' })" class="cal-chip block truncate rounded px-1 py-0.5 text-[10px] leading-tight <%= chipCls(e) %>"><%= e.title %></a>
                  <% } %>
                <% }); %>
                <% if (day.events.length > 3) { %><button type="button" @click.stop="openDay('<%= day.key %>')" class="text-[10px] text-slate-400 pl-1 hover:text-brand-600">+<%= day.events.length - 3 %> więcej</button><% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% }); %>
    </div>

    <% } else if (view === 'week') { %>
    <%# Widok TYGODNIA z siatką godzin (0–24). Przypomnienia = bloki wg godziny/długości;
        terminy/wygasania = pasek „cały dzień". %>
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
      <div class="grid" style="grid-template-columns: 3rem repeat(7, minmax(0,1fr))">
        <div class="border-b border-r border-slate-100"></div>
        <% days.forEach(function(day){ %>
          <div data-cal-head data-cal-cell <%= day.isToday ? 'data-today' : '' %> class="px-1 py-2 text-center border-b border-r border-slate-100 last:border-r-0">
            <div class="text-[11px] font-medium text-slate-400"><%= day.dowLabel %></div>
            <div @click.stop="openDay('<%= day.key %>')" class="mx-auto mt-0.5 text-xs inline-flex items-center justify-center w-6 h-6 rounded-full cursor-pointer <%= day.isToday ? 'bg-brand-600 text-white font-semibold' : 'text-slate-600 hover:bg-slate-100' %>"><%= day.day %></div>
          </div>
        <% }); %>
      </div>
      <% if (days.some(function(d){ return d.allDay.length; })) { %>
        <div class="grid border-b border-slate-100" style="grid-template-columns: 3rem repeat(7, minmax(0,1fr))">
          <div class="text-[9px] text-slate-400 pr-1 py-1 text-right leading-tight border-r border-slate-100 self-center">cały<br>dzień</div>
          <% days.forEach(function(day){ %>
            <div class="p-1 border-r border-slate-100 last:border-r-0 space-y-0.5 min-h-[1.5rem]">
              <% day.allDay.forEach(function(e){ %>
                <a href="<%= e.href %>" title="<%= e.title %>" @contextmenu.prevent.stop="openMenu($event, { type: '<%= e.kind %>', id: <%= e.id %>, href: '<%= e.href %>' })" class="cal-chip block truncate rounded px-1 py-0.5 text-[10px] leading-tight <%= chipCls(e) %>"><%= e.title %></a>
              <% }); %>
            </div>
          <% }); %>
        </div>
      <% } %>
      <div class="overflow-y-auto max-h-[560px]" x-init="$el.scrollTop = 7 * 44">
        <div data-timegrid class="grid relative" style="grid-template-columns: 3rem repeat(7, minmax(0,1fr))">
          <div class="relative border-r border-slate-100" style="height: 1056px">
            <% for (var h = 1; h < 24; h++) { %><div class="absolute right-1 text-[10px] text-slate-400 -translate-y-1/2" style="top: <%= h * 44 %>px"><%= (h < 10 ? '0' : '') + h %>:00</div><% } %>
          </div>
          <% days.forEach(function(day){ %>
            <div data-daycol data-daykey="<%= day.key %>" class="relative border-r border-slate-100 last:border-r-0 <%= day.isToday ? 'bg-brand-600/[0.03]' : '' %>" style="height: 1056px"
                 @click="openAt('<%= day.key %>', $event)" @contextmenu.prevent="openMenu($event, { type: 'day', key: '<%= day.key %>' })">
              <% for (var h = 1; h < 24; h++) { %><div class="absolute left-0 right-0 border-t border-slate-100/70" style="top: <%= h * 44 %>px"></div><% } %>
              <% if (day.isToday) { %><div class="absolute left-0 right-0 border-t-2 border-red-400 z-20 pointer-events-none" x-bind:style="'top:'+nowTop()+'px'"></div><% } %>
              <% day.timed.forEach(function(e){ var w = 100 / e.colCount; %>
                <button type="button" data-remid="<%= e.id %>" data-timed @click.stop="openEdit(REM[<%= e.id %>])" @contextmenu.prevent.stop="openMenu($event, { type: 'reminder', id: <%= e.id %> })" title="<%= e.title %>"
                        class="cal-chip absolute rounded px-1 py-0.5 text-[10px] leading-tight overflow-hidden text-left z-10 cursor-grab active:cursor-grabbing <%= chipCls(e) %>"
                        style="top: <%= e.top %>px; height: <%= e.height %>px; left: calc(<%= e.colIndex * w %>% + 2px); width: calc(<%= w %>% - 4px);">
                  <span class="opacity-60"><%= evTime(e.date) %></span> <%= e.title %>
                </button>
              <% }); %>
            </div>
          <% }); %>
        </div>
      </div>
    </div>

    <% } else { %>
    <%# Widok DNIA z siatką godzin. %>
    <% var d0 = days[0]; %>
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
        <span class="text-sm font-semibold text-slate-700 capitalize"><%= d0.dowLabel %></span>
        <button type="button" @click="openNew('<%= d0.key %>')" class="text-brand-700 hover:underline text-sm inline-flex items-center gap-1"><%- icon('plus', { size: 14, cls: '' }) %> Dodaj</button>
      </div>
      <% if (d0.allDay.length) { %>
        <div class="flex items-start gap-2 px-4 py-2 border-b border-slate-100">
          <span class="text-[10px] text-slate-400 pt-0.5 shrink-0">cały dzień</span>
          <div class="flex flex-wrap gap-1">
            <% d0.allDay.forEach(function(e){ %><a href="<%= e.href %>" title="<%= e.title %>" @contextmenu.prevent.stop="openMenu($event, { type: '<%= e.kind %>', id: <%= e.id %>, href: '<%= e.href %>' })" class="cal-chip rounded px-1.5 py-0.5 text-[11px] <%= chipCls(e) %>"><%= e.title %></a><% }); %>
          </div>
        </div>
      <% } %>
      <div class="overflow-y-auto max-h-[560px]" x-init="$el.scrollTop = 7 * 44">
        <div data-timegrid class="grid relative" style="grid-template-columns: 3.5rem minmax(0,1fr)">
          <div class="relative border-r border-slate-100" style="height: 1056px">
            <% for (var h = 1; h < 24; h++) { %><div class="absolute right-1 text-[10px] text-slate-400 -translate-y-1/2" style="top: <%= h * 44 %>px"><%= (h < 10 ? '0' : '') + h %>:00</div><% } %>
          </div>
          <div data-daycol data-daykey="<%= d0.key %>" class="relative" style="height: 1056px"
               @click="openAt('<%= d0.key %>', $event)" @contextmenu.prevent="openMenu($event, { type: 'day', key: '<%= d0.key %>' })">
            <% for (var h = 1; h < 24; h++) { %><div class="absolute left-0 right-0 border-t border-slate-100/70" style="top: <%= h * 44 %>px"></div><% } %>
            <% if (d0.isToday) { %><div class="absolute left-0 right-0 border-t-2 border-red-400 z-20 pointer-events-none" x-bind:style="'top:'+nowTop()+'px'"></div><% } %>
            <% if (!d0.timed.length && !d0.allDay.length) { %><div class="absolute inset-x-0 top-[300px] text-center text-sm text-slate-400 pointer-events-none">Brak wydarzeń — kliknij godzinę, aby dodać.</div><% } %>
            <% d0.timed.forEach(function(e){ var w = 100 / e.colCount; %>
              <button type="button" data-remid="<%= e.id %>" data-timed @click.stop="openEdit(REM[<%= e.id %>])" @contextmenu.prevent.stop="openMenu($event, { type: 'reminder', id: <%= e.id %> })" title="<%= e.title %>"
                      class="cal-chip absolute rounded px-2 py-1 text-[11px] leading-tight overflow-hidden text-left z-10 cursor-grab active:cursor-grabbing <%= chipCls(e) %>"
                      style="top: <%= e.top %>px; height: <%= e.height %>px; left: calc(<%= e.colIndex * w %>% + 3px); width: calc(<%= w %>% - 6px);">
                <span class="font-medium"><%= evTime(e.date) %></span> <%= e.title %>
              </button>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <div class="flex items-center gap-4 mt-2 text-[11px] text-slate-400">
      <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-brand-400"></span> Przypomnienie</span>
      <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Płatność</span>
      <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span> Wygasa transfer</span>
    </div>
  </div>

  <!-- PANEL: nadchodzące + zrobione (zwijany — szerszy kalendarz) -->
  <div class="space-y-4" x-show="sideOpen" x-cloak>
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-100 text-sm font-medium text-slate-700">Nadchodzące i zaległe</div>
      <% if (!upcoming.length) { %>
        <div class="px-4 py-8 text-center text-sm text-slate-400">Nic na horyzoncie 🎉</div>
      <% } else { %>
        <div class="divide-y divide-slate-100">
          <% upcoming.forEach(function(e){ %>
            <div class="px-4 py-2.5 flex items-start gap-2">
              <% if (e.kind === 'reminder') { %>
                <form method="POST" action="/admin/calendar/reminders/<%= e.id %>/toggle" class="shrink-0 mt-0.5"><input type="hidden" name="month" value="<%= curMonth %>" /><input type="hidden" name="view" value="<%= view %>" /><input type="hidden" name="date" value="<%= viewDate %>" />
                  <button type="submit" class="w-4 h-4 rounded border <%= e.done ? 'bg-brand-600 border-brand-600' : 'border-slate-300 hover:border-brand-500' %> inline-flex items-center justify-center" title="Zrobione"><% if (e.done) { %><%- icon('check', { size: 12, cls: 'text-white' }) %><% } %></button>
                </form>
              <% } else { %>
                <span class="shrink-0 mt-1 w-2 h-2 rounded-full <%= e.kind === 'charge' ? 'bg-amber-400' : 'bg-sky-400' %>"></span>
              <% } %>
              <div class="min-w-0 flex-1">
                <div class="text-sm text-slate-800 break-words"><%= e.title %></div>
                <div class="text-xs mt-0.5 flex items-center gap-1.5 flex-wrap">
                  <span class="<%= e.overdue ? 'text-red-600 font-medium' : 'text-slate-400' %>"><%= fmt.date(e.date) %><%= e.overdue ? ' · zaległe' : '' %></span>
                  <% if (e.sub) { %><span class="text-slate-400">· <%= e.sub %></span><% } %>
                  <% if (e.kind === 'reminder' && e.priority === 'high') { %><span class="px-1.5 rounded-full bg-red-50 text-red-700">pilne</span><% } %>
                </div>
              </div>
              <div class="flex items-center gap-1 shrink-0">
                <% if (e.kind === 'reminder') { %>
                  <button type="button" @click="openEdit(REM[<%= e.id %>])" class="text-slate-400 hover:text-brand-700 p-1" title="Edytuj"><%- icon('pencil', { size: 14, cls: '' }) %></button>
                  <form method="POST" action="/admin/calendar/reminders/<%= e.id %>/delete" onsubmit="return confirm('Usunąć przypomnienie?');"><input type="hidden" name="month" value="<%= curMonth %>" /><input type="hidden" name="view" value="<%= view %>" /><input type="hidden" name="date" value="<%= viewDate %>" /><button type="submit" class="text-slate-400 hover:text-red-600 p-1" title="Usuń"><%- icon('trash', { size: 14, cls: '' }) %></button></form>
                <% } else if (e.href) { %>
                  <a href="<%= e.href %>" class="text-slate-400 hover:text-brand-700 p-1" title="Otwórz"><%- icon('externalLink', { size: 14, cls: '' }) %></a>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <% if (doneReminders.length) { %>
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden" x-data="{ open: false }">
      <button type="button" @click="open = !open" class="w-full flex items-center justify-between px-4 py-3 text-left hover:bg-slate-50 transition">
        <span class="text-sm font-medium text-slate-700">Zrobione (<%= doneReminders.length %>)</span>
        <span :class="open && 'rotate-180'" class="transition-transform inline-flex text-slate-400"><%- icon('chevronDown', { size: 16, cls: '' }) %></span>
      </button>
      <div x-show="open" x-cloak class="divide-y divide-slate-100 border-t border-slate-100">
        <% doneReminders.forEach(function(e){ %>
          <div class="px-4 py-2 flex items-center gap-2">
            <div class="min-w-0 flex-1">
              <div class="text-sm text-slate-400 line-through truncate"><%= e.title %></div>
              <div class="text-xs text-slate-400"><%= fmt.date(e.date) %><% if (e.sub) { %> · <%= e.sub %><% } %></div>
            </div>
            <form method="POST" action="/admin/calendar/reminders/<%= e.id %>/toggle"><input type="hidden" name="month" value="<%= curMonth %>" /><input type="hidden" name="view" value="<%= view %>" /><input type="hidden" name="date" value="<%= viewDate %>" /><button type="submit" class="text-xs text-brand-700 hover:underline px-1 shrink-0" title="Oznacz jako niezrobione">Przywróć</button></form>
            <form method="POST" action="/admin/calendar/reminders/<%= e.id %>/delete" onsubmit="return confirm('Usunąć przypomnienie?');"><input type="hidden" name="month" value="<%= curMonth %>" /><input type="hidden" name="view" value="<%= view %>" /><input type="hidden" name="date" value="<%= viewDate %>" /><button type="submit" class="text-slate-400 hover:text-red-600 p-1 shrink-0" title="Usuń"><%- icon('trash', { size: 14, cls: '' }) %></button></form>
          </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>

  <!-- MODAL: dodaj / edytuj przypomnienie -->
  <div x-show="formOpen" x-cloak x-transition.opacity @keydown.escape.window="formOpen=false" class="fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4" @click.self="formOpen=false">
    <form method="POST" :action="form.id ? '/admin/calendar/reminders/' + form.id : '/admin/calendar/reminders'" class="bg-white rounded-2xl w-full max-w-lg p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
      <input type="hidden" name="month" value="<%= curMonth %>" /><input type="hidden" name="view" value="<%= view %>" /><input type="hidden" name="date" value="<%= viewDate %>" />
      <div class="text-base font-semibold text-slate-800 mb-4" x-text="form.id ? 'Edytuj przypomnienie' : 'Nowe przypomnienie'"></div>
      <input name="title" x-model="form.title" required maxlength="200" placeholder="Co zrobić?" class="field" />

      <%# Początek + koniec (koniec puste = 1 godz.). %>
      <div class="grid grid-cols-2 gap-3 mt-3">
        <label class="block">
          <span class="block text-[11px] font-medium text-slate-500 mb-1">Początek</span>
          <input name="dueAt" type="datetime-local" x-model="form.dueAt" required class="field field-sm" />
        </label>
        <label class="block">
          <span class="block text-[11px] font-medium text-slate-500 mb-1">Koniec <span class="text-slate-400 font-normal">· puste = 1 godz.</span></span>
          <input name="endAt" type="datetime-local" x-model="form.endAt" :min="form.dueAt" class="field field-sm" />
        </label>
      </div>

      <%# Priorytet + kolor (kolor pusty = wg priorytetu). %>
      <div class="grid grid-cols-2 gap-3 mt-3">
        <label class="block">
          <span class="block text-[11px] font-medium text-slate-500 mb-1">Priorytet</span>
          <select name="priority" x-model="form.priority" class="field field-sm">
            <option value="low">Niski</option><option value="normal">Normalny</option><option value="high">Wysoki</option>
          </select>
        </label>
        <div>
          <span class="block text-[11px] font-medium text-slate-500 mb-1">Kolor <span class="text-slate-400 font-normal">· auto = priorytet</span></span>
          <input type="hidden" name="color" :value="form.color" />
          <div class="flex items-center gap-1.5 h-[34px]">
            <button type="button" @click="form.color=''" :class="!form.color ? 'ring-2 ring-offset-1 ring-brand-400' : ''" class="w-6 h-6 rounded-full border border-slate-300 bg-white inline-flex items-center justify-center" title="Auto (wg priorytetu)"><span class="text-[9px] text-slate-400">A</span></button>
            <% Object.keys(COLOR_SWATCH).forEach(function(cname){ %>
              <button type="button" @click="form.color='<%= cname %>'" :class="form.color==='<%= cname %>' ? 'ring-2 ring-offset-1 ring-brand-400' : ''" class="w-6 h-6 rounded-full <%= COLOR_SWATCH[cname] %>" title="<%= cname %>"></button>
            <% }); %>
          </div>
        </div>
      </div>

      <%# Powtarzanie — tylko przy tworzeniu (seria materializowana). %>
      <div x-show="!form.id" class="mt-3">
        <span class="block text-[11px] font-medium text-slate-500 mb-1">Powtarzaj</span>
        <div class="flex items-center gap-2 flex-wrap">
          <select name="repeat" x-model="form.repeat" class="field field-sm">
            <option value="none">Nie</option><option value="daily">Codziennie</option><option value="weekly">Co tydzień</option><option value="monthly">Co miesiąc</option>
          </select>
          <template x-if="form.repeat !== 'none'">
            <div class="flex items-center gap-1.5">
              <span class="text-xs text-slate-500">do</span>
              <input name="repeatUntil" type="date" x-model="form.repeatUntil" class="field field-sm" />
              <span class="text-[11px] text-slate-400">puste = 6 mies.</span>
            </div>
          </template>
        </div>
      </div>
      <div x-show="form.id && form.seriesId" x-cloak class="mt-2 text-[11px] text-slate-400">Część serii powtórzeń — zmiany dotyczą tylko tego wystąpienia.</div>

      <%# Powiązania. %>
      <div class="grid grid-cols-2 gap-3 mt-3">
        <label class="block">
          <span class="block text-[11px] font-medium text-slate-500 mb-1">Klient</span>
          <select name="clientId" x-model="form.clientId" class="field field-sm">
            <option value="">—</option>
            <% clients.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
          </select>
        </label>
        <label class="block">
          <span class="block text-[11px] font-medium text-slate-500 mb-1">Projekt</span>
          <select name="projectId" x-model="form.projectId" class="field field-sm">
            <option value="">—</option>
            <% projects.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }); %>
          </select>
        </label>
      </div>
      <textarea name="note" x-model="form.note" rows="2" placeholder="Notatka (opcjonalnie)" class="field mt-3"></textarea>
      <div class="flex items-center gap-2 mt-3">
        <button type="submit" class="btn btn-primary">Zapisz</button>
        <button type="button" @click="formOpen=false" class="text-sm text-slate-500 hover:text-slate-700 px-2">Anuluj</button>
        <button type="button" x-show="form.id && form.seriesId" x-cloak @click="if(confirm('Usunąć CAŁĄ serię powtórzeń?')) action('/admin/calendar/reminders/' + form.id + '/delete', { series: 1 })" class="ml-auto text-sm text-red-600 hover:underline">Usuń serię</button>
      </div>
    </form>
  </div>

  <!-- MODAL: panel dnia -->
  <div x-show="dayOpen" x-cloak x-transition.opacity @keydown.escape.window="dayOpen=false" class="fixed inset-0 z-40 bg-black/40 flex items-center justify-center p-4" @click.self="dayOpen=false">
    <div class="bg-white rounded-2xl w-full max-w-md p-5 shadow-2xl">
      <div class="flex items-center justify-between mb-3">
        <div class="text-sm font-semibold text-slate-700" x-text="dayTitle()"></div>
        <button type="button" @click="openNew(dayKey)" class="text-brand-700 hover:underline text-sm">+ Dodaj</button>
      </div>
      <div class="space-y-1.5 max-h-[60vh] overflow-y-auto">
        <template x-for="e in dayEvents()" :key="e.kind + '-' + e.id">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full shrink-0" :class="dotCls(e)"></span>
            <template x-if="e.kind === 'reminder'">
              <button type="button" @click="openEdit(REM[e.id])" class="text-sm text-left flex-1 truncate hover:text-brand-700" :class="e.done && 'line-through text-slate-400'" x-text="e.title"></button>
            </template>
            <template x-if="e.kind !== 'reminder'">
              <a :href="e.href" class="text-sm flex-1 truncate hover:text-brand-700" x-text="e.title"></a>
            </template>
          </div>
        </template>
        <div x-show="!dayEvents().length" class="text-sm text-slate-400 py-4 text-center">Brak wydarzeń tego dnia.</div>
      </div>
    </div>
  </div>

  <!-- MENU PODRĘCZNE (prawy‑klik) -->
  <div x-show="menuOpen" x-cloak @click.outside="menuOpen=false" @keydown.escape.window="menuOpen=false" :style="'left:' + menuX + 'px;top:' + menuY + 'px'" class="fixed z-[60] bg-white rounded-lg border border-slate-200 shadow-lg py-1 text-sm w-48">
    <template x-if="menu.type === 'day'">
      <button type="button" @click="openNew(menu.key)" class="w-full text-left px-3 py-1.5 hover:bg-slate-50">Dodaj przypomnienie tu</button>
    </template>
    <template x-if="menu.type === 'reminder'">
      <div>
        <button type="button" @click="openEdit(REM[menu.id])" class="w-full text-left px-3 py-1.5 hover:bg-slate-50">Edytuj</button>
        <button type="button" @click="action('/admin/calendar/reminders/' + menu.id + '/toggle')" class="w-full text-left px-3 py-1.5 hover:bg-slate-50"><span x-text="(REM[menu.id] && REM[menu.id].done) ? 'Cofnij (niezrobione)' : 'Oznacz zrobione'"></span></button>
        <template x-if="REM[menu.id] && REM[menu.id].href"><a :href="REM[menu.id].href" class="block px-3 py-1.5 hover:bg-slate-50">Otwórz źródło</a></template>
        <button type="button" @click="if (confirm('Usunąć przypomnienie?')) action('/admin/calendar/reminders/' + menu.id + '/delete')" class="w-full text-left px-3 py-1.5 hover:bg-slate-50 text-red-600">Usuń</button>
        <template x-if="REM[menu.id] && REM[menu.id].seriesId"><button type="button" @click="if (confirm('Usunąć CAŁĄ serię powtórzeń?')) action('/admin/calendar/reminders/' + menu.id + '/delete', { series: 1 })" class="w-full text-left px-3 py-1.5 hover:bg-slate-50 text-red-600">Usuń serię</button></template>
      </div>
    </template>
    <template x-if="menu.type === 'charge' || menu.type === 'transfer'">
      <a :href="menu.href" class="block px-3 py-1.5 hover:bg-slate-50">Otwórz</a>
    </template>
  </div>
</div>

<script>
  var MONTHS_GEN = ['stycznia','lutego','marca','kwietnia','maja','czerwca','lipca','sierpnia','września','października','listopada','grudnia'];
  function calTodayKey(){ var d=new Date(),p=function(n){return String(n).padStart(2,'0');}; return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate()); }
  function calendar() {
    return {
      REM: <%- jsonJs(remindersMap) %>,
      EVBYDAY: <%- jsonJs(eventsByDayMap) %>,
      MONTH: '<%= curMonth %>',
      VIEW: '<%= view %>',
      VDATE: '<%= viewDate %>',
      sideOpen: (function () { try { return localStorage.getItem('evoke-cal-side') !== '0'; } catch (e) { return true; } })(),
      formOpen: false,
      form: { id: null, title: '', note: '', dueAt: '', endAt: '', priority: 'normal', color: '', clientId: '', projectId: '', repeat: 'none', repeatUntil: '', seriesId: '' },
      dayOpen: false, dayKey: null,
      menuOpen: false, menuX: 0, menuY: 0, menu: { type: null, id: null, key: null, href: '' },

      openNew(key, time) {
        var d = key || calTodayKey();
        this.form = { id: null, title: '', note: '', dueAt: d + 'T' + (time || '09:00'), endAt: '', priority: 'normal', color: '', clientId: '', projectId: '', repeat: 'none', repeatUntil: '', seriesId: '' };
        this.formOpen = true; this.menuOpen = false; this.dayOpen = false;
      },
      // Klik w siatkę godzin (tydzień/dzień): oblicz godzinę z pozycji Y → nowe przypomnienie.
      openAt(key, ev) {
        var rect = ev.currentTarget.getBoundingClientRect();
        var h = Math.max(0, Math.min(23, Math.floor((ev.clientY - rect.top) / 44)));
        this.openNew(key, (h < 10 ? '0' : '') + h + ':00');
      },
      // Pozycja linii „teraz" (px) na siatce godzin.
      nowTop() { var d = new Date(); return Math.round(((d.getHours() * 60 + d.getMinutes()) / 60) * 44); },
      openEdit(r) {
        if (!r) return;
        this.form = { id: r.id, title: r.title, note: r.note || '', dueAt: r.dueAt, endAt: r.endAt || '', priority: r.priority || 'normal', color: r.color || '', clientId: r.clientId != null ? String(r.clientId) : '', projectId: r.projectId != null ? String(r.projectId) : '', repeat: 'none', repeatUntil: '', seriesId: r.seriesId || '' };
        this.formOpen = true; this.menuOpen = false; this.dayOpen = false;
      },
      openDay(key) { this.dayKey = key; this.dayOpen = true; this.menuOpen = false; },
      openMenu(ev, target) {
        this.menu = Object.assign({ type: null, id: null, key: null, href: '' }, target);
        this.menuX = Math.min(ev.clientX, window.innerWidth - 200);
        this.menuY = Math.min(ev.clientY, window.innerHeight - 170);
        this.menuOpen = true;
      },
      action(url, extra) {
        var f = document.createElement('form'); f.method = 'POST'; f.action = url;
        var add = function (n, v) { var i = document.createElement('input'); i.type = 'hidden'; i.name = n; i.value = v; f.appendChild(i); };
        add('month', this.MONTH); add('view', this.VIEW); add('date', this.VDATE);
        if (extra) Object.keys(extra).forEach(function (k) { add(k, extra[k]); });
        document.body.appendChild(f); f.submit();
      },
      dayEvents() { return this.EVBYDAY[this.dayKey] || []; },
      dayTitle() { if (!this.dayKey) return ''; var s = this.dayKey.split('-'); return parseInt(s[2], 10) + ' ' + MONTHS_GEN[parseInt(s[1], 10) - 1] + ' ' + s[0]; },
      dotCls(e) { if (e.done) return 'bg-slate-300'; return e.kind === 'reminder' ? (e.priority === 'high' ? 'bg-red-500' : 'bg-brand-500') : (e.kind === 'charge' ? 'bg-amber-400' : 'bg-sky-400'); },
    };
  }
</script>
<script src="/js/sortable.min.js"></script>
<script>
  // Drag & drop: przeciągnięcie przypomnienia do innego dnia = zmiana terminu (godzina zostaje).
  (function () {
    if (!window.Sortable) return;
    document.querySelectorAll('.cal-events').forEach(function (col) {
      Sortable.create(col, {
        group: 'cal',
        draggable: '[data-remid]', // tylko przypomnienia (płatności/transfery nie)
        animation: 150,
        ghostClass: 'opacity-50',
        onAdd: function (evt) {
          var id = evt.item.getAttribute('data-remid');
          var day = evt.to.getAttribute('data-day');
          fetch('/admin/calendar/reminders/' + id + '/move', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ day: day }),
          }).then(function () { location.reload(); }).catch(function () { location.reload(); });
        },
      });
    });
  })();
</script>
<script>
  // Drag na siatce godzin (tydzień/dzień): pionowo = godzina (snap 15 min), poziomo = inny dzień.
  (function () {
    var HOUR_PX = 44, STEP = HOUR_PX / 4; // 15 min
    var pad2 = function (n) { return String(n).padStart(2, '0'); };
    var grid = document.querySelector('[data-timegrid]');
    if (!grid) return;
    var cols = Array.prototype.slice.call(grid.querySelectorAll('[data-daycol]'));
    if (!cols.length) return;
    var drag = null;
    grid.querySelectorAll('[data-timed]').forEach(function (el) {
      el.addEventListener('mousedown', function (e) {
        if (e.button !== 0) return;
        e.preventDefault();
        var rect = el.getBoundingClientRect();
        drag = { el: el, id: el.getAttribute('data-remid'), grabY: e.clientY - rect.top, height: el.offsetHeight, moved: false, top: el.offsetTop, col: el.parentNode };
        el.style.opacity = '0.85'; el.style.zIndex = '40';
      });
    });
    document.addEventListener('mousemove', function (e) {
      if (!drag) return;
      drag.moved = true;
      var col = drag.col;
      cols.forEach(function (c) { var r = c.getBoundingClientRect(); if (e.clientX >= r.left && e.clientX < r.right) col = c; });
      if (col !== drag.el.parentNode) { col.appendChild(drag.el); drag.col = col; }
      var r = col.getBoundingClientRect();
      var top = Math.round((e.clientY - r.top - drag.grabY) / STEP) * STEP;
      top = Math.max(0, Math.min(top, 24 * HOUR_PX - drag.height));
      drag.el.style.top = top + 'px';
      drag.top = top;
    });
    document.addEventListener('mouseup', function () {
      if (!drag) return;
      var d = drag; drag = null;
      d.el.style.opacity = ''; d.el.style.zIndex = '';
      if (!d.moved) return; // to był klik, nie drag → zostaw openEdit
      // zablokuj klik, który padnie zaraz po drag (inaczej otworzy się modal edycji)
      var block = function (ev) { ev.stopPropagation(); ev.preventDefault(); document.removeEventListener('click', block, true); };
      document.addEventListener('click', block, true);
      setTimeout(function () { document.removeEventListener('click', block, true); }, 60);
      var mins = Math.round(d.top / STEP) * 15;
      var dueAt = d.col.getAttribute('data-daykey') + 'T' + pad2(Math.floor(mins / 60)) + ':' + pad2(mins % 60);
      fetch('/admin/calendar/reminders/' + d.id + '/reschedule', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ dueAt: dueAt }),
      }).then(function () { location.reload(); }).catch(function () { location.reload(); });
    });
  })();
</script>
