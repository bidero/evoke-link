<div class="page-head mb-6">
  <form method="GET" action="/admin/clients" class="flex flex-col gap-2 sm:flex-row sm:items-center w-full sm:w-auto">
    <div class="relative w-full sm:max-w-xs">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"><%- icon('search', { size: 16 }) %></span>
      <input type="search" name="q" value="<%= q %>" placeholder="Szukaj klienta, e-maila lub firmy…" class="field w-full pl-9 pr-3" />
    </div>
    <select name="status" onchange="this.form.submit()" class="field pl-3 pr-9">
      <% [['','Wszyscy'],['lead','Lead'],['active','Aktywni'],['inactive','Nieaktywni']].forEach(function(o){ %>
        <option value="<%= o[0] %>" <%= status === o[0] ? 'selected' : '' %>><%= o[1] %></option>
      <% }); %>
    </select>
    <select name="sort" onchange="this.form.submit()" title="Sortowanie" class="field pl-3 pr-9">
      <% [
        ['name_asc','Nazwa A–Z'], ['name_desc','Nazwa Z–A'],
        ['company_asc','Firma A–Z'], ['company_desc','Firma Z–A'],
        ['lastname_asc','Nazwisko A–Z'], ['lastname_desc','Nazwisko Z–A'],
      ].forEach(function(o){ %>
        <option value="<%= o[0] %>" <%= sort === o[0] ? 'selected' : '' %>><%= o[1] %></option>
      <% }); %>
    </select>
    <%# Filtr po tagu (dokładne dopasowanie) — lista z chmury tagów kartotek. %>
    <% if ((tags || []).length) { %>
      <select name="tag" onchange="this.form.submit()" title="Filtr po tagu" class="field pl-3 pr-9">
        <option value="">Wszystkie tagi</option>
        <% tags.forEach(function(t){ %><option value="<%= t.tag %>" <%= tag === t.tag ? 'selected' : '' %>><%= t.tag %> (<%= t.count %>)</option><% }); %>
      </select>
    <% } else if (tag) { %>
      <input type="hidden" name="tag" value="<%= tag %>" />
    <% } %>
    <%# Eksport respektuje bieżące filtry (te same parametry co widok). %>
    <% const _cqs = new URLSearchParams(Object.entries({ q: q, status: status, sort: sort, tag: tag }).filter(function(e){ return e[1]; })).toString(); %>
    <a href="/admin/clients.csv<%= _cqs ? '?' + _cqs : '' %>" class="btn btn-secondary" title="Eksportuj widoczną listę do CSV"><%- icon('download', { size: 15, cls: '' }) %> CSV</a>
  </form>
  <a href="/admin/clients/new" class="btn btn-primary self-start sm:self-auto shrink-0">+ Nowy klient</a>
</div>

<% if (sent === 'ok') { %>
  <div class="alert alert-ok mb-4"><%- icon('check', { size: 16, cls: 'text-green-600' }) %> Wysłano link panelu klienta.</div>
<% } else if (sent === 'dev') { %>
  <div class="alert alert-warn mb-4">SMTP niewłączony — link panelu trafił do logów serwera (tryb deweloperski).</div>
<% } else if (sent === 'invalid') { %>
  <div class="alert alert-error mb-4">Klient nie ma poprawnego adresu e-mail.</div>
<% } else if (sent === 'error') { %>
  <div class="alert alert-error mb-4">Nie udało się wysłać. Sprawdź ustawienia SMTP.</div>
<% } %>

<% if (!clients.length) { %>
  <div class="bg-white rounded-2xl border border-slate-200 p-10 text-center text-slate-500">
    <% if (q) { %>
      <p>Brak wyników dla „<%= q %>".</p>
    <% } else { %>
      <p class="mb-3">Brak klientów.</p>
      <a href="/admin/clients/new" class="text-brand-700 font-medium hover:underline">Dodaj pierwszego klienta →</a>
    <% } %>
  </div>
<% } else { %>
  <%# Desktop (od lg): zwarta tabela. Wcześniej 7 kolumn z pełnym adresem portalu i e-mailem
      zawijanym na 3 linie nie mieściło się nawet na 1280 px (przycisk „Wyślij" poza kartą).
      Teraz: e-mail pod nazwą w jednej linii, portal/wysyłka jako ikony w ostatniej kolumnie,
      „Projekty" dopiero od xl. Poniżej lg — karty (kolumna treści obok paska jest za wąska). %>
  <div class="hidden lg:block bg-white rounded-2xl border border-slate-200 overflow-hidden">
    <table class="w-full text-sm table-fixed">
      <thead class="bg-slate-50 text-slate-500 text-left">
        <tr>
          <th class="px-4 py-3 font-medium">Klient</th>
          <th class="px-4 py-3 font-medium w-32">Status</th>
          <th class="px-4 py-3 font-medium w-24 hidden xl:table-cell">Projekty</th>
          <th class="px-4 py-3 font-medium w-40 text-right">Do rozliczenia</th>
          <th class="px-4 py-3 w-28"><span class="sr-only">Akcje</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% const _statusMap = { lead: ['Lead', 'bg-amber-50 text-amber-700'], active: ['Aktywny', 'bg-green-50 text-green-700'], inactive: ['Nieaktywny', 'bg-slate-100 text-slate-500'] }; %>
        <% clients.forEach(function(c){ const _s = _statusMap[c.status] || _statusMap.active; %>
          <tr class="hover:bg-slate-50 cursor-pointer" onclick="window.evokeVisit('/admin/clients/<%= c.id %>')">
            <td class="px-4 py-3">
              <span class="flex items-center gap-3 min-w-0">
                <%- avatar(c, { size: 'sm' }) %>
                <span class="min-w-0">
                  <span class="block truncate font-medium text-slate-800"><%= c.name %></span>
                  <span class="block truncate text-xs text-slate-400"><%= [c.company, c.email].filter(Boolean).join(' · ') || '—' %></span>
                </span>
              </span>
            </td>
            <td class="px-4 py-3"><span class="text-xs px-2 py-0.5 rounded-full whitespace-nowrap <%= _s[1] %>"><%= _s[0] %></span></td>
            <td class="px-4 py-3 text-slate-500 hidden xl:table-cell"><%= c._count.projects %></td>
            <td class="px-4 py-3 tabular-nums text-right whitespace-nowrap"><% if (c.outstanding > 0) { %><span class="text-amber-600 font-medium"><%= fmt.money(c.outstanding) %></span><% } else { %><span class="text-slate-300">—</span><% } %></td>
            <td class="px-4 py-3" onclick="event.stopPropagation()">
              <span class="flex items-center justify-end gap-1.5">
                <a href="<%= appUrl %>/c/<%= c.token %>" target="_blank" class="btn-icon" title="Otwórz portal klienta" aria-label="Otwórz portal klienta"><%- icon('externalLink', { size: 15, cls: '' }) %></a>
                <% if (c.email) { %>
                  <form method="POST" action="/admin/clients/<%= c.id %>/send-panel">
                    <input type="hidden" name="redirect" value="list" />
                    <button type="submit" class="btn-icon" title="Wyślij link portalu na <%= c.email %>" aria-label="Wyślij link portalu"><%- icon('mail', { size: 15, cls: '' }) %></button>
                  </form>
                <% } %>
              </span>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <%# Telefon i tablet (poniżej lg): karty zamiast tabeli. %>
  <div class="lg:hidden space-y-3">
    <% clients.forEach(function(c){ const _s = _statusMap[c.status] || _statusMap.active; %>
      <div class="bg-white rounded-xl border border-slate-200 p-4">
        <div class="flex items-start justify-between gap-3">
          <a href="/admin/clients/<%= c.id %>" class="min-w-0 flex items-center gap-2.5">
            <%- avatar(c, { size: 'sm' }) %>
            <span class="min-w-0">
              <span class="block font-medium text-slate-800 truncate"><%= c.name %></span>
              <% if (c.company) { %><span class="block text-xs text-slate-400 truncate"><%= c.company %></span><% } %>
            </span>
          </a>
          <span class="text-xs px-2 py-0.5 rounded-full shrink-0 <%= _s[1] %>"><%= _s[0] %></span>
        </div>
        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
          <% if (c.email) { %><span class="truncate max-w-full"><%= c.email %></span><% } %>
          <span>Projekty: <%= c._count.projects %></span>
          <% if (c.outstanding > 0) { %><span class="text-amber-600 font-medium">Do zapłaty: <%= fmt.money(c.outstanding) %></span><% } %>
        </div>
        <div class="mt-3 flex items-center justify-end gap-2">
          <a href="<%= appUrl %>/c/<%= c.token %>" target="_blank" class="btn btn-secondary text-xs"><%- icon('externalLink', { size: 14 }) %> Portal</a>
          <% if (c.email) { %>
            <form method="POST" action="/admin/clients/<%= c.id %>/send-panel" class="shrink-0">
              <input type="hidden" name="redirect" value="list" />
              <button type="submit" title="Wyślij link panelu na <%= c.email %>" class="btn btn-secondary text-xs"><%- icon('mail', { size: 14 }) %> Wyślij</button>
            </form>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>
