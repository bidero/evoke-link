<div class="max-w-xl">
  <% if (error) { %>
    <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-3 py-2"><%= error %></div>
  <% } %>
  <form method="POST" action="/admin/clients" enctype="multipart/form-data" class="space-y-5 bg-white rounded-2xl border border-slate-200 p-6">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Nazwa klienta *</label>
      <input name="name" type="text" required placeholder="np. Marka XYZ"
             class="field" />
      <p class="text-xs text-slate-400 mt-1">Nazwa wyświetlana (firma lub osoba). Imię/nazwisko poniżej służą tylko do personalizacji maili.</p>
    </div>
    <%# Awatar = logo klienta; bez pliku pokazujemy kółko z inicjałem (stabilny kolor z nazwy). %>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Logo / awatar <span class="text-slate-400 font-normal">(opcjonalnie)</span></label>
      <input name="avatar" type="file" accept="image/*"
             class="w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:text-brand-700 file:px-3 file:py-1.5 file:text-sm file:font-medium hover:file:bg-brand-100" />
      <p class="text-xs text-slate-400 mt-1">Kwadrat wygląda najlepiej. Bez pliku klient dostanie kółko z inicjałem.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Imię <span class="text-slate-400 font-normal">(do powitań w mailu)</span></label>
        <input name="firstName" type="text" placeholder="np. Radek"
               class="field" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Nazwisko</label>
        <input name="lastName" type="text" placeholder="np. Biedermann"
               class="field" />
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">E-mail (do wysyłki linków)</label>
        <input name="email" type="email" placeholder="kontakt@marka.pl"
               class="field" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Telefon</label>
        <input name="phone" type="text" placeholder="np. 600 100 200"
               class="field" />
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Firma</label>
        <input name="company" type="text" placeholder="np. Marka XYZ Sp. z o.o."
               class="field" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
        <select name="status" class="field">
          <option value="lead">Lead</option>
          <option value="active" selected>Aktywny</option>
          <option value="inactive">Nieaktywny</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Rytm kontaktu <span class="text-slate-400 font-normal">(przypominaj co)</span></label>
        <select name="contactEveryDays" class="field">
          <option value="">— bez rytmu —</option>
          <option value="7">co tydzień (7 dni)</option>
          <option value="14">co 2 tygodnie (14 dni)</option>
          <option value="30">co miesiąc (30 dni)</option>
          <option value="60">co 2 miesiące (60 dni)</option>
          <option value="90">co kwartał (90 dni)</option>
        </select>
        <p class="text-xs text-slate-400 mt-1">Klient pojawi się w „Do odezwania się", gdy minie tyle dni od ostatniego kontaktu.</p>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">NIP <span class="text-slate-400 font-normal">(na dokument)</span></label>
        <input name="nip" type="text" placeholder="np. 123-456-78-90" class="field" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Adres <span class="text-slate-400 font-normal">(na dokument)</span></label>
        <input name="address" type="text" placeholder="ul., kod, miasto" class="field" />
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Tagi <span class="text-slate-400 font-normal">(po przecinku)</span></label>
      <input name="tags" type="text" placeholder="np. VIP, foto, retainer"
             class="field" />
      <% if (typeof tagCloud !== 'undefined' && tagCloud.length) { %>
        <div class="flex flex-wrap items-center gap-1.5 mt-2">
          <span class="text-xs text-slate-400">Często używane:</span>
          <% tagCloud.forEach(function(t){ %>
            <button type="button" class="tag-chip text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-700 transition" data-tag="<%= t.tag %>"><%= t.tag %> <span class="text-slate-400"><%= t.count %></span></button>
          <% }); %>
        </div>
        <script>
          document.querySelectorAll('.tag-chip').forEach(function (b) {
            b.addEventListener('click', function () {
              var t = this.getAttribute('data-tag');
              var i = document.querySelector('input[name=tags]');
              if (!i) return;
              var a = i.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
              if (a.indexOf(t) === -1) { a.push(t); i.value = a.join(', '); }
              i.focus();
            });
          });
        </script>
      <% } %>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Notatka (opcjonalnie)</label>
      <textarea name="note" rows="2" class="field"></textarea>
    </div>
    <div class="flex items-center gap-3">
      <button type="submit" class="btn btn-lg btn-primary">Dodaj klienta</button>
      <a href="/admin/clients" class="text-sm text-slate-500 hover:text-slate-700">Anuluj</a>
    </div>
  </form>
</div>
